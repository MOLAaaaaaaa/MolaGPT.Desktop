<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MolaGPT.Desktop</RootNamespace>
    <AssemblyName>MolaGPT.Desktop</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The cloud sync path serializes whole payloads to multi-MB strings/byte[],
       which land on the Large Object Heap. The LOH is only swept on gen2
       collections (rare in an idle desktop app) and is never compacted by
       default, so dead sync buffers accumulate as committed-but-unused segments
       — measured at 78 MB of free blocks in a 156 MB LOH after ~6 minutes idle.
       ConserveMemory makes the GC compact the LOH during full blocking
       collections and decommit more eagerly, trading some CPU for a flat
       memory profile. 5 of 9 keeps the pauses unobtrusive. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MolaGPT.Core\MolaGPT.Core.csproj" />
    <ProjectReference Include="..\MolaGPT.Storage\MolaGPT.Storage.csproj" />
    <ProjectReference Include="..\MolaGPT.ViewModels\MolaGPT.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-logo.png" />
    <Resource Include="Assets\GeistVariableVF.ttf" />
    <Resource Include="Assets\fa-solid-900.ttf" />
    <None Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Built-in Agent Skills shipped next to the app; SkillManager scans <AppDir>/skills. -->
  <ItemGroup>
    <Content Include="skills\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Themes\Tokens.Light.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Themes\Tokens.Dark.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Themes\Generic.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
