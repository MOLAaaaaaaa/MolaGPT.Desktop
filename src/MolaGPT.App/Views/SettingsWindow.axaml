<v:MolaContentWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MolaGPT.ViewModels;assembly=MolaGPT.ViewModels"
        xmlns:pres="clr-namespace:MolaGPT.Presentation;assembly=MolaGPT.Presentation"
        xmlns:m="clr-namespace:MolaGPT.Core.Models;assembly=MolaGPT.Core"
        xmlns:v="clr-namespace:MolaGPT.App.Views"
        xmlns:agents="clr-namespace:MolaGPT.ViewModels.Agents;assembly=MolaGPT.ViewModels"
        xmlns:dto="clr-namespace:MolaGPT.Core.Chat.Agents;assembly=MolaGPT.Core"
        xmlns:relay="clr-namespace:MolaGPT.Core.Chat.Agents.Relay;assembly=MolaGPT.Core"
        xmlns:repo="clr-namespace:MolaGPT.Storage.Repositories;assembly=MolaGPT.Storage"
        x:Class="MolaGPT.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置 — MolaGPT"
        HeaderTitle="设置"
        Width="1044" Height="704"
        CanResize="True" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg.Elevated}"
        FontFamily="{DynamicResource Font.Cjk}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}">

  <Window.Resources>
    <v:AgentSessionLabelConverter x:Key="AgentSessionLabel" />
    <DataTemplate x:Key="ProviderCardTemplate" x:DataType="v:ProviderCardRow">
      <Border Classes="providercard">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BaseUrl}"
                       FontSize="{DynamicResource Font.Size.XSmall}"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <Border Grid.Column="1" Classes="countpill" VerticalAlignment="Center"
                  IsVisible="{Binding IsInactive}"
                  Background="{DynamicResource Brush.Warning.Surface}"
                  BorderBrush="{DynamicResource Brush.Warning.Border}"
                  BorderThickness="1"
                  ToolTip.Tip="已保存，但没有出现在模型选择器中">
            <TextBlock Text="{Binding InactiveReason}"
                       FontSize="{DynamicResource Font.Size.XSmall}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Warning.Foreground}" />
          </Border>
          <Border Grid.Column="2" Classes="countpill" VerticalAlignment="Center">
            <TextBlock Text="{Binding ModelCount}"
                       FontSize="{DynamicResource Font.Size.XSmall}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Muted}" />
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Classes="inlineaction" Click="OnEditProvider" Tag="{Binding Id}"
                    ToolTip.Tip="编辑">
              <TextBlock Classes="icon" Text="&#xE70F;" FontSize="13" />
            </Button>
            <Button Classes="inlineaction" Click="OnDeleteProvider" Tag="{Binding Id}"
                    ToolTip.Tip="删除">
              <TextBlock Classes="icon" Text="&#xE74D;" FontSize="13" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <!-- 技能行和模型服务行是同一种东西：一条摊在页面上的记录，勾选框管启用，
         右边两个图标管「看文件」和「删掉」。所以借同一套卡片度量，不再另起
         一个左右分栏的外壳把它们装起来。 -->
    <DataTemplate x:Key="SkillCardTemplate" x:DataType="vm:SkillItemViewModel">
      <Border Classes="providercard" Padding="14,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Fluent 的 CheckBox 自带 32 的 MinHeight，勾选框在里面垂直居中，
               贴着标题行放就会比标题矮半行。 -->
          <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                    MinHeight="0" VerticalAlignment="Top" Margin="0,0,12,0"
                    ToolTip.Tip="启用此技能" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                       FontSize="{DynamicResource Font.Size.XSmall}"
                       Foreground="{DynamicResource Brush.Text.Muted}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Classes="inlineaction" Click="OnViewSkillMd" Tag="{Binding}"
                    ToolTip.Tip="{Binding DirectoryPath}">
              <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="13" />
            </Button>
            <Button Classes="inlineaction" Click="OnDeleteSkill" Tag="{Binding}"
                    IsVisible="{Binding !IsBuiltin}" ToolTip.Tip="删除">
              <TextBlock Classes="icon" Text="&#xE74D;" FontSize="13" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Border Background="{DynamicResource Brush.Bg.Elevated}"
            ClipToBounds="True">
      <DockPanel>
        <Grid ColumnDefinitions="208,*">
          <Border Grid.Column="0"
                  Background="{DynamicResource Brush.Bg.Secondary}"
                  BorderBrush="{DynamicResource Brush.Divider}"
                  BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ListBox Name="PART_Nav"
                       Background="Transparent"
                       BorderThickness="0"
                       Margin="10,0,10,14"
                       Padding="0"
                       SelectedIndex="1">
                <ListBoxItem Classes="navgroup" IsEnabled="False" Content="通用" />
                <ListBoxItem Content="账号与同步" />
                <ListBoxItem Content="界面与偏好" />
                <ListBoxItem Name="PART_MemoryNav">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="本地记忆" VerticalAlignment="Center" />
                    <!-- 自动整理开着但没选模型：它不会运行，这个点是唯一的提示。
                         持续状态属于设置页行内，不发通知横幅。 -->
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Error}"
                             VerticalAlignment="Center" IsVisible="{Binding MemoryNeedsModel}" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="navgroup" IsEnabled="False" Content="模型" />
                <ListBoxItem Name="PART_ProvidersNav" Content="模型服务" />
                <ListBoxItem Name="PART_PersonasNav" Content="角色" />
                <ListBoxItem Content="联网搜索" />
                <ListBoxItem Content="会话标题" />
                <ListBoxItem Content="图像生成" />
                <ListBoxItem Content="视觉理解" />
                <ListBoxItem Name="PART_PostProcessingNav" Content="后处理" />
                <ListBoxItem Classes="navgroup" IsEnabled="False" Content="工具与环境" />
                <ListBoxItem Name="PART_SandboxNav" Content="沙箱与文件" />
                <ListBoxItem Name="PART_BrowserNav" Content="浏览器使用" />
                <ListBoxItem Content="审批与安全" />
                <ListBoxItem Content="MCP 服务器" />
                <ListBoxItem Name="PART_AgentNav" Content="Agent Bridge" />
                <ListBoxItem Name="PART_SkillsNav" Content="技能" />
              </ListBox>
            </ScrollViewer>
          </Border>

          <ScrollViewer Grid.Column="1"
                        Name="PART_ContentScroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Panel Name="PART_Pages"
                   Margin="34,26,34,34"
                   MaxWidth="760"
                   HorizontalAlignment="Stretch">

              <StackPanel Name="PAGE_Account">
                <TextBlock Classes="pagetitle" Text="账号与同步" />
                <TextBlock Classes="pagesubtitle"
                           Text="登录后可在桌面端使用 MolaGPT 网页端的模型、对话同步与个性化能力。" />

                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                      <TextBlock Name="PART_AccountStatus" Classes="rowtitle" Text="未登录" />
                      <TextBlock Name="PART_AccountDetail" Classes="hint" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Name="PART_AccountAction"
                            Classes="outline"
                            Content="登录"
                            Padding="14,7"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Classes="section" Text="数据同步" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="对话云同步" />
                        <TextBlock Classes="hint"
                                   Text="开启后，本机的 MolaGPT Chat 对话（Work、BYOK 对话除外）会与 MolaGPT 网页端双向同步。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1"
                                    Name="PART_SyncConversations"
                                    Classes="settingtoggle"
                                    IsEnabled="{Binding IsLoggedIn}"
                                    IsChecked="{Binding SyncConversations, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 Name="PART_CloudSyncStatus"
                                 Classes="hint"
                                 Margin="0,0,20,0"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1"
                              Name="PART_SyncNow"
                              Classes="outline"
                              Content="立即同步"
                              Padding="12,6"
                              IsEnabled="{Binding IsLoggedIn}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="个性化 · MolaGPT Tracks" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="启用个性化记忆" />
                        <TextBlock Classes="hint"
                                   Text="MolaGPT 会从对话中学习你的偏好，让后续回复更贴合你的需求。关闭后不会记录个性化数据，仅在登录 MolaGPT 账号时在 MolaGPT Chat 中生效。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1"
                                    Name="PART_TracksToggle"
                                    Classes="settingtoggle"
                                    IsChecked="{Binding TracksEnabled, Mode=TwoWay}"
                                    Click="OnTracksToggleClick"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="记忆与对话风格" />
                        <TextBlock Classes="hint"
                                   Text="查看 MolaGPT 记住了什么，为每条记忆评分、修正或删除，并设置回复的语气偏好。" />
                        <!-- Errors stay on the row the user is looking at, not
                             only in the corner banner. Empty until something
                             fails, so the row does not carry a permanent slot. -->
                        <TextBlock Name="PART_TracksSummary"
                                   Classes="hint"
                                   IsVisible="False"
                                   Foreground="{DynamicResource Brush.Error}" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Name="PART_ManageTracks"
                              Classes="outline"
                              Content="管理记忆"
                              Padding="12,6"
                              IsEnabled="{Binding IsLoggedIn}"
                              Click="OnManageTracksClick" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Appearance" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="界面与偏好" />
                <TextBlock Classes="pagesubtitle" Text="调整外观、输入习惯与系统集成方式。" />

                <TextBlock Classes="section" Text="外观" Margin="2,4,2,8" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="主题" />
                        <TextBlock Classes="hint" Text="切换软件内深浅色模式。" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Name="PART_Theme"
                                Classes="settingsinput"
                                MinWidth="150" VerticalAlignment="Center">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                      </ComboBox>
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,240">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="字号缩放" />
                        <TextBlock Classes="hint" Text="调整正文和界面文字大小。" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Name="PART_FontScale"
                                Classes="settingsinput" MinWidth="150"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBoxItem Content="80%" />
                        <ComboBoxItem Content="100%" />
                        <ComboBoxItem Content="120%" />
                        <ComboBoxItem Content="140%" />
                      </ComboBox>
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="思考结束后自动收起" />
                        <TextBlock Classes="hint" Text="控制已完成的思考内容是否保持展开。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Name="PART_AutoCollapseThinking"
                                    Classes="settingtoggle"
                                    IsChecked="{Binding AutoCollapseThinking, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="流式输出动画" />
                        <TextBlock Classes="hint" Text="流式输出过程中启用动画效果，可能会影响可读性。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Name="PART_StreamFade"
                                    Classes="settingtoggle"
                                    IsChecked="{Binding StreamFadeEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="状态提示点" />
                        <TextBlock Classes="hint" Text="在部分尚未配置完成的设置项旁显示提示点。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Name="PART_StatusDots"
                                    Classes="settingtoggle"
                                    IsChecked="{Binding ShowStatusDots, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="输入" />
                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="按 Enter 直接发送消息" />
                      <TextBlock Classes="hint" Text="关闭时 Enter 换行，Ctrl+Enter 发送；开启时 Shift+Enter 仍可换行。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                  IsChecked="{Binding EnterToSend, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Classes="section" Text="通知与系统集成" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="后台回答完成时通知" />
                        <TextBlock Classes="hint" Text="回答生成结束时将会发出系统通知。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding EnableCompletionNotification, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="启用系统托盘" />
                        <TextBlock Classes="hint" Text="关闭窗口时可最小化到托盘。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding EnableTrayIcon, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Name="PART_TrayBehaviorPanel"
                                IsVisible="{Binding EnableTrayIcon}">
                      <Border Classes="divider" />
                      <StackPanel Classes="fieldrow">
                        <TextBlock Classes="rowtitle" Text="关闭按钮行为" Margin="0,0,0,6" />
                        <RadioButton Name="PART_TrayMinimize" Content="最小化到托盘"
                                     GroupName="trayClose" Margin="0,4" />
                        <RadioButton Name="PART_TrayExit" Content="关闭软件"
                                     GroupName="trayClose" Margin="0,4" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Providers" IsVisible="False">
                <StackPanel Name="PART_ProviderOverview">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="pagetitle" Text="模型服务" />
                      <TextBlock Classes="pagesubtitle"
                                 Text="接入自定义模型服务并管理可用模型。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Top">
                      <Button Name="PART_FetchAllPricing" Classes="outline"
                              Content="获取模型价格" Padding="14,8"
                              ToolTip.Tip="从 models.dev 为所有对话服务的模型获取单价" />
                      <Button Name="PART_AddProvider" Classes="pillprimary"
                              Content="+ 对话服务" Padding="14,8" />
                      <Button Name="PART_AddImageProvider" Classes="outline"
                              Content="+ 图像服务" Padding="14,8" />
                    </StackPanel>
                  </Grid>

                  <Border Name="PART_PricingResult" Classes="settingscard" Padding="14"
                          Margin="0,12,0,0" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Name="PART_PricingResultText" Classes="hint"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Name="PART_ResolvePricingConflicts" Classes="outline"
                              Content="逐个确认" Padding="12,6" Margin="10,0,0,0"
                              IsVisible="False" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Name="PART_ClosePricingResult" Classes="inlineaction"
                              Margin="6,0,0,0" ToolTip.Tip="关闭" VerticalAlignment="Center">
                        <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
                      </Button>
                    </Grid>
                  </Border>

                  <TextBlock Classes="section" Text="对话服务" Margin="2,4,2,8" />
                  <ItemsControl Name="PART_ChatProviderList"
                                ItemTemplate="{StaticResource ProviderCardTemplate}" />
                  <Border Name="PART_NoChatProviders" Classes="emptystate">
                    <TextBlock Classes="hint" Text="还没有添加对话服务。"
                               HorizontalAlignment="Center" />
                  </Border>

                  <TextBlock Classes="section" Text="图像服务" />
                  <ItemsControl Name="PART_ImageProviderList"
                                ItemTemplate="{StaticResource ProviderCardTemplate}" />
                  <Border Name="PART_NoImageProviders" Classes="emptystate">
                    <TextBlock Classes="hint" Text="还没有添加图像服务。"
                               HorizontalAlignment="Center" />
                  </Border>
                </StackPanel>

                <StackPanel Name="PART_ProviderEditor" IsVisible="False">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
                    <Button Grid.Column="0" Name="PART_BackProvider" Classes="outline back"
                            ToolTip.Tip="返回模型服务" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Name="PART_ProviderEditorTitle" Classes="pagetitle"
                                 FontSize="{DynamicResource Font.Size.Heading}" />
                      <TextBlock Classes="hint" Margin="0,2,0,0"
                                 Text="配置服务地址、凭据和可用模型。" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="countpill" VerticalAlignment="Center">
                      <TextBlock Name="PART_ProviderPurpose" FontSize="{DynamicResource Font.Size.XSmall}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Border>
                  </Grid>

                  <TextBlock Classes="section" Text="服务信息" Margin="2,0,2,8" />
                  <Border Classes="settingscard" Padding="16">
                    <StackPanel Spacing="14">
                      <StackPanel>
                        <TextBlock Classes="label" Text="快速填充" />
                        <ComboBox Name="PART_ProviderPreset" Classes="settingsinput">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="v:ProviderPresetRow">
                              <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>

                      <StackPanel>
                        <TextBlock Classes="label" Text="协议" />
                        <ComboBox Name="PART_ProviderType" Classes="settingsinput">
                          <ComboBoxItem Content="OpenAI 兼容" />
                          <ComboBoxItem Content="Anthropic" />
                          <ComboBoxItem Content="Gemini" />
                          <ComboBoxItem Content="OpenAI Responses" />
                        </ComboBox>
                      </StackPanel>

                      <StackPanel>
                        <TextBlock Classes="label" Text="显示名称" />
                        <TextBox Name="PART_ProviderName" Classes="settingsinput"
                                 PlaceholderText="例如 我的 DeepSeek" />
                      </StackPanel>

                      <StackPanel>
                        <TextBlock Classes="label" Text="接口地址" />
                        <TextBox Name="PART_ProviderBaseUrl" Classes="settingsinput"
                                 PlaceholderText="https://api.example.com/" />
                      </StackPanel>

                      <StackPanel>
                        <TextBlock Name="PART_ProviderApiPathLabel" Classes="label" Text="对话路径" />
                        <TextBox Name="PART_ProviderApiPath" Classes="settingsinput"
                                 PlaceholderText="v1/chat/completions" />
                      </StackPanel>

                      <StackPanel Name="PART_ProviderImageFields" IsVisible="False" Spacing="14">
                        <StackPanel>
                          <TextBlock Classes="label" Text="接口格式" />
                          <ComboBox Name="PART_ProviderImageFormat" Classes="settingsinput">
                            <ComboBoxItem Content="OpenAI 图像接口（DALL·E、gpt-image）" />
                            <ComboBoxItem Content="对话补全出图（OpenRouter、nano-banana）" />
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Name="PART_ProviderImageEditPathField">
                          <TextBlock Classes="label" Text="编辑路径" />
                          <TextBox Name="PART_ProviderImageEditPath" Classes="settingsinput"
                                   PlaceholderText="v1/images/edits" />
                        </StackPanel>
                      </StackPanel>

                      <TextBlock Name="PART_ProviderEndpointPreview" Classes="hint" Margin="0" />

                      <StackPanel>
                        <TextBlock Classes="label" Text="API Key" />
                        <Border Classes="input">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="PART_ProviderApiKey" PasswordChar="•"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Name="PART_RevealProviderKey" Classes="inlineaction"
                                    Width="28" Height="26" ToolTip.Tip="显示 / 隐藏">
                              <TextBlock Classes="icon" Text="&#xE7B3;" FontSize="12" />
                            </Button>
                          </Grid>
                        </Border>
                        <TextBlock Classes="hint" Text="API Key 将保存在本机加密凭据库中。" />
                      </StackPanel>

                      <Expander Header="自定义请求头（高级）">
                        <StackPanel Spacing="8" Margin="0,10,0,0">
                          <ItemsControl Name="PART_ProviderHeaders">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="v:HeaderRow">
                                <Grid ColumnDefinitions="*,8,*,Auto" Margin="0,0,0,6">
                                  <TextBox Grid.Column="0" Classes="settingsinput"
                                           Text="{Binding Name, Mode=TwoWay}" PlaceholderText="名称" />
                                  <TextBox Grid.Column="2" Classes="settingsinput"
                                           Text="{Binding Value, Mode=TwoWay}" PlaceholderText="值" />
                                  <Button Grid.Column="3" Classes="inlineaction" Width="28" Height="28"
                                          Margin="6,0,0,0" Click="OnRemoveProviderHeader" ToolTip.Tip="移除">
                                    <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Name="PART_AddProviderHeader" Classes="textlink"
                                  Content="+ 添加请求头" HorizontalAlignment="Left" />
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>

                  <Grid Margin="2,20,2,8" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="section" Text="模型" Margin="0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Name="PART_DetectProviderModels" Classes="outline"
                            Content="自动获取" Padding="12,6" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="2" Name="PART_AddProviderModel" Classes="outline"
                            Content="+ 手动添加" Padding="12,6" VerticalAlignment="Center" />
                  </Grid>

                  <Border Name="PART_DetectedModelsPanel" Classes="settingscard" Padding="14"
                          Margin="0,0,0,10" IsVisible="False">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="PART_DetectedModelsTitle" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Name="PART_CloseDetectedModels" Classes="inlineaction"
                                ToolTip.Tip="关闭">
                          <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
                        </Button>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="PART_DetectedModelSearch" Classes="settingsinput"
                                 PlaceholderText="搜索模型" Margin="0,0,10,0" />
                        <CheckBox Grid.Column="1" Name="PART_SelectAllDetectedModels"
                                  Content="全选" VerticalAlignment="Center" />
                      </Grid>
                      <ListBox Name="PART_DetectedModels" Height="260"
                               Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="v:DetectedModelRow">
                            <Border Classes="detectedmodelrow">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}" Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Entry.Id}" FontWeight="SemiBold"
                                             FontSize="{DynamicResource Font.Size.Small}"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding CapabilitySummary}" Classes="hint"
                                             Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="hint"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Name="PART_NoDetectedModels" Classes="hint"
                                 Text="没有匹配的模型" HorizontalAlignment="Center" IsVisible="False" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Name="PART_CancelDetectedModels" Classes="outline"
                                Content="取消" Padding="14,6" />
                        <Button Name="PART_AddDetectedModels" Classes="pillprimary"
                                Content="添加选中模型" Padding="14,6" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <ItemsControl Name="PART_ProviderModels">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="v:ModelRow">
                        <Border Classes="providereditcard">
                          <Expander>
                            <Expander.Header>
                              <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                <StackPanel Grid.Column="0">
                                  <TextBlock Text="{Binding Id}" FontWeight="SemiBold"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding DisplayName}" Classes="hint" Margin="0,2,0,0"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="inlineaction" Width="28" Height="28"
                                        Margin="8,0,0,0" Click="OnRemoveProviderModel" ToolTip.Tip="移除">
                                  <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
                                </Button>
                              </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="10" Margin="0,10,0,2">
                              <StackPanel>
                                <TextBlock Classes="label" Text="模型 ID" />
                                <TextBox Classes="settingsinput" Text="{Binding Id, Mode=TwoWay}" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="label" Text="显示名称" />
                                <TextBox Classes="settingsinput" Text="{Binding DisplayName, Mode=TwoWay}"
                                         PlaceholderText="留空使用模型 ID" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="label" Text="上下文窗口（tokens）" />
                                <TextBox Classes="settingsinput" Text="{Binding ContextWindowText, Mode=TwoWay}"
                                         PlaceholderText="可选" />
                              </StackPanel>
                              <WrapPanel>
                                <CheckBox Content="视觉" IsChecked="{Binding Vision, Mode=TwoWay}" Margin="0,0,14,6" />
                                <CheckBox Content="工具调用" IsChecked="{Binding Tools, Mode=TwoWay}" Margin="0,0,14,6" />
                                <CheckBox Content="推理" IsChecked="{Binding Thinking, Mode=TwoWay}" Margin="0,0,14,6" />
                                <CheckBox Content="推理强度" IsChecked="{Binding ReasoningEffort, Mode=TwoWay}" Margin="0,0,14,6" />
                                <CheckBox Content="图像编辑" IsChecked="{Binding ImageEdit, Mode=TwoWay}"
                                          IsVisible="{Binding IsImageProvider}" Margin="0,0,14,6" />
                              </WrapPanel>
                              <Expander Header="推理与高级参数配置">
                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                  <StackPanel IsEnabled="{Binding Thinking}">
                                    <TextBlock Classes="label" Text="推理参数格式" />
                                    <ComboBox Classes="settingsinput" SelectedIndex="{Binding ThinkingKindIndex, Mode=TwoWay}">
                                      <ComboBoxItem Content="OpenAI Effort" />
                                      <ComboBoxItem Content="Anthropic Adaptive" />
                                      <ComboBoxItem Content="Anthropic Budget" />
                                      <ComboBoxItem Content="DeepSeek" />
                                      <ComboBoxItem Content="Gemini Level" />
                                      <ComboBoxItem Content="Gemini Budget" />
                                      <ComboBoxItem Content="Qwen Budget" />
                                    </ComboBox>
                                  </StackPanel>
                                  <Grid ColumnDefinitions="*,10,*" IsEnabled="{Binding Thinking}"
                                        IsVisible="{Binding IsEffortOptionsVisible}">
                                    <StackPanel Grid.Column="0">
                                      <TextBlock Classes="label" Text="默认强度" />
                                      <ComboBox Classes="settingsinput" ItemsSource="{Binding SelectedLevelNames}"
                                               SelectedItem="{Binding DefaultEffort, Mode=TwoWay}"
                                               HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Classes="label" Text="强度档位" />
                                      <ItemsControl ItemsSource="{Binding EffortLevelOptions}">
                                        <ItemsControl.ItemsPanel>
                                          <ItemsPanelTemplate>
                                            <WrapPanel />
                                          </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="v:EffortLevelItem">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                                              <ToggleButton Classes="toolchip" Content="{Binding Name}"
                                                           IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                              <Button Classes="inlineaction" Margin="2,0,0,0"
                                                     IsVisible="{Binding IsCustom}"
                                                     Click="OnRemoveCustomEffortLevel"
                                                     ToolTip.Tip="移除该档位">
                                                <TextBlock Classes="icon" Text="&#xE711;" FontSize="10" />
                                              </Button>
                                            </StackPanel>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Classes="settingsinput"
                                                Text="{Binding CustomEffortInput, Mode=TwoWay}"
                                                PlaceholderText="自定义强度名称"
                                                Margin="0,0,6,0"
                                                KeyDown="OnCustomEffortKeyDown" />
                                        <Button Grid.Column="1" Classes="textlink" Content="+ 添加"
                                               Click="OnAddCustomEffortLevel"
                                               VerticalAlignment="Center" />
                                      </Grid>
                                    </StackPanel>
                                  </Grid>
                                  <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding Thinking}"
                                             IsVisible="{Binding IsBudgetOptionsVisible}">
                                    <TextBlock Classes="label" Text="预算预设" VerticalAlignment="Center" Margin="0" />
                                    <ItemsControl ItemsSource="{Binding BudgetPresetOptions}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="v:BudgetPreset">
                                          <Button Classes="toolchip" Content="{Binding Name}"
                                                 ToolTip.Tip="{Binding Description}"
                                                 Click="OnApplyBudgetPreset" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                  <Grid ColumnDefinitions="*,8,*,8,*" IsEnabled="{Binding Thinking}"
                                        IsVisible="{Binding IsBudgetOptionsVisible}">
                                    <StackPanel Grid.Column="0">
                                      <TextBlock Classes="label" Text="最小 Budget" />
                                      <TextBox Classes="settingsinput" Text="{Binding BudgetMinText, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Classes="label" Text="默认 Budget" />
                                      <TextBox Classes="settingsinput" Text="{Binding BudgetDefaultText, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                      <TextBlock Classes="label" Text="最大 Budget" />
                                      <TextBox Classes="settingsinput" Text="{Binding BudgetMaxText, Mode=TwoWay}" />
                                    </StackPanel>
                                  </Grid>
                                  <StackPanel>
                                    <TextBlock Classes="label" Text="生成参数" />
                                    <WrapPanel>
                                      <CheckBox Content="Temperature" IsChecked="{Binding SupportsTemperature, Mode=TwoWay}" Margin="0,0,14,6" />
                                      <CheckBox Content="Top-p" IsChecked="{Binding SupportsTopP, Mode=TwoWay}" Margin="0,0,14,6" />
                                    </WrapPanel>
                                    <TextBlock Classes="hint" Text="勾选后即在请求中使用该参数，可在角色管理中配置。" />
                                  </StackPanel>
                                  <StackPanel>
                                    <TextBlock Classes="label" Text="价格（USD / 1M tokens）" />
                                    <Grid ColumnDefinitions="*,8,*,8,*,8,*">
                                      <StackPanel Grid.Column="0">
                                        <TextBlock Classes="hint" Text="输入" Margin="0,0,0,4" />
                                        <TextBox Classes="settingsinput" Text="{Binding PriceInputText, Mode=TwoWay}" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="2">
                                        <TextBlock Classes="hint" Text="输出" Margin="0,0,0,4" />
                                        <TextBox Classes="settingsinput" Text="{Binding PriceOutputText, Mode=TwoWay}" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="4">
                                        <TextBlock Classes="hint" Text="缓存读" Margin="0,0,0,4" />
                                        <TextBox Classes="settingsinput" Text="{Binding PriceCacheReadText, Mode=TwoWay}" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="6">
                                        <TextBlock Classes="hint" Text="缓存写" Margin="0,0,0,4" />
                                        <TextBox Classes="settingsinput" Text="{Binding PriceCacheWriteText, Mode=TwoWay}" />
                                      </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="hint" Text="{Binding PriceSourceLabel}" />
                                  </StackPanel>
                                  <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Classes="label" Text="参数覆写" VerticalAlignment="Center" />
                                      <Button Grid.Column="1" Classes="textlink" Content="+ 添加参数"
                                              Click="OnAddProviderBody" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CustomBodyRows}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="v:BodyRow">
                                          <Grid ColumnDefinitions="*,8,110,8,*,Auto" Margin="0,0,0,6">
                                            <TextBox Grid.Column="0" Classes="settingsinput"
                                                     Text="{Binding Key, Mode=TwoWay}" PlaceholderText="参数名" />
                                            <ComboBox Grid.Column="2" Classes="settingsinput"
                                                      SelectedIndex="{Binding TypeIndex, Mode=TwoWay}">
                                              <ComboBoxItem Content="string" />
                                              <ComboBoxItem Content="number" />
                                              <ComboBoxItem Content="boolean" />
                                              <ComboBoxItem Content="json" />
                                            </ComboBox>
                                            <TextBox Grid.Column="4" Classes="settingsinput"
                                                     Text="{Binding Value, Mode=TwoWay}" PlaceholderText="值" />
                                            <Button Grid.Column="5" Classes="inlineaction" Margin="6,0,0,0"
                                                    Click="OnRemoveProviderBody" ToolTip.Tip="移除">
                                              <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
                                            </Button>
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </StackPanel>
                              </Expander>
                            </StackPanel>
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Name="PART_NoProviderModels" Classes="hint"
                             Text="至少添加一个模型。" />
                  <TextBlock Name="PART_ProviderStatus" Classes="hint" IsVisible="False"
                             Margin="0,12,0,0" />
                  <TextBlock Name="PART_ProviderError" Classes="hint" IsVisible="False"
                             Foreground="{DynamicResource Brush.Error}" Margin="0,12,0,0" />

                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,18,0,0">
                    <Button Grid.Column="0" Name="PART_DeleteEditingProvider" Classes="outline"
                            Content="删除服务" Padding="14,7" />
                    <Button Grid.Column="2" Name="PART_TestProvider" Classes="outline"
                            Content="测试连接" Padding="16,7" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Name="PART_SaveProvider" Classes="pillprimary"
                            Content="保存" Padding="18,7" />
                    <Button Name="PART_CancelProviderEdit" IsVisible="False" />
                  </Grid>
                </StackPanel>
              </StackPanel>

              <StackPanel Name="PAGE_Personas" IsVisible="False">
                <Grid Name="PART_PersonaPageHeader" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
                  <Button Grid.Column="0" Name="PART_PersonaBack" Classes="outline back"
                          IsVisible="False" ToolTip.Tip="返回角色列表" Click="OnBackToPersonas" />
                  <TextBlock Grid.Column="1" Name="PART_PersonaPageTitle" Classes="pagetitle" Text="角色" Margin="0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Name="PART_PersonaLibraryActions" Orientation="Horizontal" Spacing="8">
                    <Button Classes="outline" Content="导入" Click="OnImportPersona" Padding="14,6" />
                    <Button Name="PART_NewPersona" Classes="pillprimary" Content="新建角色" Click="OnNewPersona" Padding="14,6" />
                  </StackPanel>
                </Grid>

                <Grid Name="PART_PersonaLayout" Height="540">
                  <Grid Name="PART_PersonaRail" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,12,136" Margin="0,0,0,12">
                    <Border Classes="searchbox" Height="36" Padding="12,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="icon" Text="&#xE721;" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Name="PART_PersonaSearch" PlaceholderText="搜索角色" TextChanged="OnPersonaSearchChanged" />
                        <Button Grid.Column="2" Name="PART_ClearPersonaSearch" Classes="toolchip" Width="24" Height="24" MinHeight="24" Padding="0" IsVisible="False" ToolTip.Tip="清空搜索" AutomationProperties.Name="清空搜索">
                          <TextBlock Classes="icon" Text="&#xE711;" FontSize="10" />
                        </Button>
                      </Grid>
                    </Border>
                    <ComboBox Grid.Column="2" Name="PART_PersonaModeFilter" Classes="field" Height="36" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="按角色模式筛选">
                      <ComboBoxItem Content="全部模式" /><ComboBoxItem Content="对话" /><ComboBoxItem Content="氛围" />
                    </ComboBox>
                    </Grid>
                    <ListBox Grid.Row="1" Name="PART_PersonaList" Classes="plainlist" SelectionChanged="OnPersonaSelectionChanged">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonaItemViewModel">
                          <Border Classes="personacard" Padding="14" MinHeight="104">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <v:PersonaAvatar Value="{Binding Avatar}" Width="38" Height="38" VerticalAlignment="Top" Margin="0,2,12,0" />
                              <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ModeLabel}" Classes="muted" FontSize="12" />
                                <TextBlock Text="{Binding Preview}" IsVisible="{Binding HasPreview}" Classes="muted" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Preview}" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Classes="icon" Text="&#xE72E;" FontSize="11" IsVisible="{Binding IsBuiltin}" ToolTip.Tip="内置角色" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Name="PART_PersonaEmpty" Classes="emptystate" Text="暂无角色" IsVisible="False" />
                  </Grid>

                  <Grid Name="PART_PersonaEditorSurface" RowDefinitions="*,Auto" IsVisible="False">
                    <Grid Name="PART_PersonaEditor" RowDefinitions="Auto,*" x:DataType="vm:PersonaItemViewModel">
                      <StackPanel>
                        <Border Name="PART_PersonaBuiltinHint" IsVisible="False" Margin="0,0,0,12">
                          <TextBlock Text="内置角色，可复制编辑" Classes="hint" Margin="0" />
                        </Border>
                        <Grid ColumnDefinitions="Auto,16,*,16,124" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                          <StackPanel Grid.RowSpan="2" Spacing="6" VerticalAlignment="Center">
                            <Button Name="PART_PersonaIconPicker" Classes="outline" Padding="5" IsEnabled="{Binding !IsBuiltin}" ToolTip.Tip="更换头像">
                              <v:PersonaAvatar Value="{Binding Avatar}" Width="44" Height="44" />
                              <Button.Flyout>
                                <Flyout FlyoutPresenterClasses="molaflyout">
                                  <Border Classes="flyoutsurface" Padding="12" DataContext="{Binding #PART_PersonaEditor.DataContext}" x:DataType="vm:PersonaItemViewModel">
                                    <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                      <Button Name="PART_PersonaImage" Content="上传图片" Classes="textlink" Click="OnPersonaImage" IsEnabled="{Binding !IsBuiltin}" />
                                      <Button Name="PART_PersonaImageClear" Content="移除图片" Classes="textlink" Click="OnPersonaImageClear" IsEnabled="{Binding !IsBuiltin}" IsVisible="{Binding HasImageAvatar}" />
                                    </StackPanel>
                                    <ItemsControl Name="PART_PersonaIcons" Width="234">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="v:PersonaIconRow">
                                          <Button Classes="inlineaction" Width="34" Height="34" Margin="2" Tag="{Binding Glyph}" ToolTip.Tip="{Binding Label}" Click="OnPersonaIcon">
                                            <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="16" />
                                          </Button>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                  </Border>
                                </Flyout>
                              </Button.Flyout>
                            </Button>
                          </StackPanel>
                          <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label" Text="名称" Margin="0" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="收藏" MinHeight="32" Margin="0" Padding="8,0,0,0" FontSize="12" VerticalAlignment="Center" IsChecked="{Binding Pinned, Mode=TwoWay}" IsEnabled="{Binding !IsBuiltin}" Click="OnPersonaFormChanged" />
                          </Grid>
                          <TextBlock Grid.Column="4" Classes="label" Text="模式" Margin="0" VerticalAlignment="Center" />
                          <TextBox Grid.Row="1" Grid.Column="2" Name="PART_PersonaName" Classes="field" Margin="0,6,0,0" Text="{Binding Name, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                          <ComboBox Grid.Row="1" Grid.Column="4" Name="PART_PersonaMode" Classes="field" Margin="0,6,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBuiltin}" SelectionChanged="OnPersonaModeChanged">
                            <ComboBoxItem Content="对话" /><ComboBoxItem Content="氛围" />
                          </ComboBox>
                        </Grid>
                      </StackPanel>

                      <TabControl Grid.Row="1" Name="PART_PersonaTabs" Classes="molatabs">
                        <TabItem Header="设定">
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                            <StackPanel Margin="0,14,0,8" IsEnabled="{Binding !IsBuiltin}">
                              <TextBlock Classes="label" Text="简介" Margin="0,0,0,6" />
                              <TextBox Classes="field" Text="{Binding Profile.Summary, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                              <StackPanel IsVisible="{Binding IsAtmosphereMode}" Margin="0,14,0,0">
                                <TextBlock Classes="label" Text="角色资料" Margin="0,0,0,6" />
                                <TextBox Classes="field" Text="{Binding Profile.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" LostFocus="OnPersonaFormChanged" />
                                <TextBlock Classes="label" Text="性格与表达" Margin="0,14,0,6" />
                                <TextBox Classes="field" Text="{Binding Profile.Personality, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" LostFocus="OnPersonaFormChanged" />
                                <TextBlock Classes="label" Text="场景" Margin="0,14,0,6" />
                                <TextBox Classes="field" Text="{Binding Profile.Scenario, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" LostFocus="OnPersonaFormChanged" />
                                <!-- Same row as the drop-down, centred in it: see
                                     ConversationRoleWindow, which carries the same pair. -->
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,14,0,0">
                                  <TextBlock Classes="label" Text="我的身份" />
                                  <ComboBox Grid.Row="1" Name="PART_RoleIdentity" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnRoleIdentityChanged">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="v:RoleIdentityChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <Button Grid.Row="1" Grid.Column="1" Content="管理身份" Classes="textlink" Click="OnManageIdentities" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <Expander Name="PART_RoleExtraDefinitions" Header="更多设定" Classes="settingssection" Margin="0,14,0,0">
                                  <StackPanel Margin="0,10,0,0">
                                    <StackPanel Name="PART_RoleManualIdentity">
                                    <TextBlock Classes="label" Text="你的称呼" Margin="0,0,0,6" />
                                    <TextBox Classes="field" Text="{Binding Profile.UserName, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                                    <TextBlock Classes="label" Text="你的身份" Margin="0,14,0,6" />
                                    <TextBox Classes="field" Text="{Binding Profile.UserDescription, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" LostFocus="OnPersonaFormChanged" />
                                    </StackPanel>
                                    <TextBlock Classes="label" Text="对话示例" Margin="0,14,0,6" />
                                    <TextBox Classes="field" Text="{Binding Profile.ExampleDialogue, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" LostFocus="OnPersonaFormChanged" />
                                    <TextBlock Classes="label" Text="补充指令" Margin="0,14,0,6" />
                                    <TextBox Classes="field" Text="{Binding Profile.PostHistoryInstructions, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" LostFocus="OnPersonaFormChanged" />
                                  </StackPanel>
                                </Expander>
                              </StackPanel>
                              <Expander Header="系统提示词" Classes="settingssection" Margin="0,14,0,0" IsExpanded="{Binding !IsAtmosphereMode}">
                                <StackPanel Margin="0,10,0,0">
                                  <TextBox Name="PART_PersonaPrompt" Classes="field" Text="{Binding SystemPrompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="176" MaxHeight="300" LostFocus="OnPersonaFormChanged" TextChanged="OnPersonaPromptTextChanged" />
                                  <TextBlock Name="PART_PersonaPromptCacheHint" Classes="hint" IsVisible="False" Margin="0,6,0,0" />
                                  <Button Name="PART_PersonaVariables" Content="插入变量" Classes="textlink" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Button.Flyout>
                                      <Flyout FlyoutPresenterClasses="molaflyout">
                                        <Border Classes="flyoutsurface" Padding="12">
                                          <WrapPanel Width="280">
                                            <Button Classes="toolchip" Content="日期" Tag="{}{{date}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="时间" Tag="{}{{time}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="日期和时间" Tag="{}{{datetime}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="模型" Tag="{}{{model}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="模型服务" Tag="{}{{provider}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="用户名" Tag="{}{{username}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="角色名称" Tag="{}{{char}}" Click="OnInsertPersonaVariable" Margin="2" />
                                            <Button Classes="toolchip" Content="你的称呼" Tag="{}{{user}}" Click="OnInsertPersonaVariable" Margin="2" />
                                          </WrapPanel>
                                        </Border>
                                      </Flyout>
                                    </Button.Flyout>
                                  </Button>
                                </StackPanel>
                              </Expander>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>

                        <TabItem Header="开场" IsVisible="{Binding IsAtmosphereMode}">
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                            <StackPanel Margin="0,14,0,8" IsEnabled="{Binding !IsBuiltin}">
                              <TextBlock Classes="label" Text="开场白" Margin="0,0,0,6" />
                              <TextBox Classes="field" Text="{Binding Profile.Greeting, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="156" MaxHeight="280" LostFocus="OnPersonaFormChanged" />
                              <Expander Name="PART_AlternateGreetingsExpander" Classes="settingssection" Header="备选开场" Margin="0,16,0,0">
                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                  <ComboBox Name="PART_AlternateGreetings" Classes="field" HorizontalAlignment="Stretch" PlaceholderText="暂无备选开场白">
                                    <!-- HorizontalAlignment 必须写死 Left：Avalonia 的 ArrangeCore 把
                                         Stretch 和 Center 归到同一分支，被 MaxWidth 夹住之后剩余宽度
                                         左右平分，于是 560 宽的文字在 696 宽的位置里向右挪了 68px。 -->
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" MaxWidth="560" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button Classes="textlink" Content="添加" Click="OnAddGreeting" />
                                    <Button Name="PART_EditGreeting" Classes="textlink" Content="编辑" Click="OnEditGreeting" />
                                    <Button Name="PART_DeleteGreeting" Classes="textlink" Content="删除" Click="OnDeleteGreeting" />
                                  </StackPanel>
                                </StackPanel>
                              </Expander>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>

                        <TabItem Header="世界书" IsVisible="{Binding IsAtmosphereMode}">
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                          <StackPanel Margin="0,14,0,8">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                              <TextBlock Classes="label" Text="角色世界书" VerticalAlignment="Center" Margin="0" />
                              <Button Grid.Column="1" Name="PART_RoleLorebooks" Classes="outline" Content="管理" Click="OnRoleLorebooks" IsEnabled="{Binding !IsBuiltin}" />
                            </Grid>
                            <ItemsControl Name="PART_RoleBooks" ItemTemplate="{StaticResource LorebookSummaryTemplate}" />
                            <TextBlock Name="PART_RoleBooksEmpty" Classes="hint" Text="角色未添加世界书" Margin="0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,6">
                              <TextBlock Classes="label" Text="共享世界书" VerticalAlignment="Center" Margin="0" />
                              <Button Grid.Column="1" Classes="outline" Content="管理共享库" Click="OnSharedLorebooks" IsEnabled="{Binding !IsBuiltin}" />
                            </Grid>
                            <StackPanel Name="PART_SharedBooks" IsEnabled="{Binding !IsBuiltin}" />
                            <TextBlock Name="PART_SharedBooksEmpty" Classes="hint" Text="共享库为空" Margin="0" />
                            <StackPanel Name="PART_GlobalLoreBudgetRow" Margin="0,16,0,0" IsEnabled="{Binding !IsBuiltin}">
                              <TextBlock Classes="label" Text="总预算（tokens）" />
                              <NumericUpDown Classes="field" Value="{Binding Profile.LoreBudget, Mode=TwoWay}" Minimum="0" Maximum="1000000" FormatString="N0" Width="180" HorizontalAlignment="Left" LostFocus="OnPersonaFormChanged" />
                            </StackPanel>
                          </StackPanel>
                          </ScrollViewer>
                        </TabItem>

                        <TabItem Header="卡片" IsVisible="{Binding !IsBuiltin}">
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                            <StackPanel Margin="0,14,0,8" Spacing="12">
                              <TextBlock Name="PART_CardSummary" Classes="muted" />
                              <Grid ColumnDefinitions="*,12,*">
                                <StackPanel>
                                  <TextBlock Classes="label" Text="角色称呼" />
                                  <TextBox Classes="field" Text="{Binding Profile.Nickname, Mode=TwoWay}" PlaceholderText="沿用角色名称" LostFocus="OnPersonaFormChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                  <TextBlock Classes="label" Text="兼容方式" />
                                  <ComboBox Name="PART_RoleCompatibility" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnRoleCardOptionsChanged">
                                    <ComboBoxItem Content="角色卡规范" /><ComboBoxItem Content="SillyTavern" />
                                  </ComboBox>
                                </StackPanel>
                              </Grid>
                              <Grid ColumnDefinitions="*,12,*">
                                <StackPanel>
                                  <TextBlock Classes="label" Text="作者" />
                                  <TextBox Classes="field" Text="{Binding Profile.Creator, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                  <TextBlock Classes="label" Text="角色版本" />
                                  <TextBox Classes="field" Text="{Binding Profile.CharacterVersion, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                                </StackPanel>
                              </Grid>
                              <StackPanel>
                                <TextBlock Classes="label" Text="标签" />
                                <TextBox Classes="field" Text="{Binding TagsText, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="label" Text="作者说明" />
                                <TextBox Classes="field" Text="{Binding Profile.CreatorNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="180" LostFocus="OnPersonaFormChanged" />
                              </StackPanel>
                              <Expander Name="PART_ImportDetails" Classes="settingssection" Header="导入内容">
                                <TextBlock Name="PART_ImportNotes" TextWrapping="Wrap" Classes="hint" Margin="0,10,0,0" />
                              </Expander>
                              <Expander Classes="settingssection" Header="角色补充" IsVisible="{Binding IsAtmosphereMode}">
                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                  <TextBox Classes="field" Text="{Binding Profile.CharacterNote, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" LostFocus="OnPersonaFormChanged" />
                                  <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                      <TextBlock Classes="label" Text="距对话末尾" />
                                      <NumericUpDown Classes="field" Value="{Binding Profile.CharacterNoteDepth, Mode=TwoWay}" Minimum="0" Maximum="1000" FormatString="0' 条消息'" ToolTip.Tip="0 表示放在对话末尾" LostFocus="OnPersonaFormChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Classes="label" Text="消息身份" />
                                      <ComboBox Name="PART_RoleNoteRole" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnRoleCardOptionsChanged">
                                        <ComboBoxItem Content="系统" /><ComboBoxItem Content="用户" /><ComboBoxItem Content="角色" />
                                      </ComboBox>
                                    </StackPanel>
                                  </Grid>
                                </StackPanel>
                              </Expander>
                              <StackPanel Name="PART_ExportBookRow">
                                <TextBlock Classes="label" Text="随卡导出的世界书" />
                                <ComboBox Name="PART_ExportBook" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnRoleCardOptionsChanged">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="m:Lorebook"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </StackPanel>
                              <WrapPanel Orientation="Horizontal">
                                <ComboBox Name="PART_CardExportVersion" Classes="field" Width="90" Margin="0,0,8,8" ToolTip.Tip="导出格式">
                                  <ComboBoxItem Content="V3" /><ComboBoxItem Content="V2" />
                                </ComboBox>
                                <Button Classes="outline" Content="导出 JSON" Tag="json" Click="OnExportPersona" Margin="0,0,8,8" />
                                <Button Classes="outline" Content="导出 PNG" Tag="png" Click="OnExportPersona" Margin="0,0,8,8" />
                                <Button Name="PART_UpdateRoleCard" Classes="outline" Content="从文件更新" Click="OnUpdateRoleCard" Margin="0,0,0,8" />
                              </WrapPanel>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>
                        <TabItem Header="模型与工具">
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                            <StackPanel Margin="0,14,0,8" IsEnabled="{Binding !IsBuiltin}">
                              <TextBlock Classes="label" Text="默认模型" Margin="0,0,0,6" />
                              <ComboBox Name="PART_RoleModel" Classes="field" SelectionChanged="OnRoleModelChanged" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="v:RoleModelChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <Expander Name="PART_PersonaDefaultsExpander" Classes="settingssection" Header="默认行为" Margin="0,16,0,0" IsExpanded="True">
                                <StackPanel Name="PART_PersonaDefaults" Margin="0,10,0,0" Spacing="8">
                                  <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                      <TextBlock Classes="label" Text="网络访问" Margin="0,0,0,6" />
                                      <ComboBox Name="PART_PersonaNetwork" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnPersonaFormChanged">
                                        <ComboBoxItem Content="关闭" /><ComboBoxItem Content="开启" />
                                      </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Classes="label" Text="推理" Margin="0,0,0,6" />
                                      <ComboBox Name="PART_PersonaThinking" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnPersonaFormChanged">
                                        <ComboBoxItem Content="关闭" /><ComboBoxItem Content="开启" />
                                      </ComboBox>
                                    </StackPanel>
                                  </Grid>
                                  <TextBlock Classes="label" Text="工具" Margin="0,8,0,0" />
                                  <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                                    <StackPanel>
                                      <TextBlock Classes="label" Text="Python" Margin="0,0,0,6" />
                                      <ComboBox Name="PART_PersonaPython" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnPersonaFormChanged">
                                        <ComboBoxItem Content="沿用全局" /><ComboBoxItem Content="启用" /><ComboBoxItem Content="禁用" />
                                      </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Classes="label" Text="文件读写" Margin="0,0,0,6" />
                                      <ComboBox Name="PART_PersonaFileTools" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnPersonaFormChanged">
                                        <ComboBoxItem Content="沿用全局" /><ComboBoxItem Content="启用" /><ComboBoxItem Content="禁用" />
                                      </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                      <TextBlock Classes="label" Text="图像生成" Margin="0,0,0,6" />
                                      <ComboBox Name="PART_PersonaImageGeneration" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnPersonaFormChanged">
                                        <ComboBoxItem Content="沿用全局" /><ComboBoxItem Content="启用" /><ComboBoxItem Content="禁用" />
                                      </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                      <TextBlock Classes="label" Text="MCP" Margin="0,0,0,6" />
                                      <ComboBox Name="PART_PersonaMcp" Classes="field" HorizontalAlignment="Stretch" SelectionChanged="OnPersonaFormChanged">
                                        <ComboBoxItem Content="沿用全局" /><ComboBoxItem Content="启用" /><ComboBoxItem Content="禁用" />
                                      </ComboBox>
                                    </StackPanel>
                                  </Grid>
                                </StackPanel>
                              </Expander>
                              <Expander Name="PART_PersonaSamplingExpander" Classes="settingssection" Header="生成参数" Margin="0,16,0,0">
                                <StackPanel Name="PART_PersonaSampling" Spacing="8" Margin="0,10,0,0">
                                  <TextBlock Classes="hint" Text="留空则不发送该参数，由模型使用默认值。" Margin="0,0,0,4" />
                                  <Grid ColumnDefinitions="*,14,*">
                                    <StackPanel>
                                      <TextBlock Classes="label" Text="Temperature" Margin="0,0,0,6" />
                                      <NumericUpDown Name="PART_RoleTemperature" Classes="field" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.##" HorizontalAlignment="Stretch" Value="{Binding Profile.Temperature, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Classes="label" Text="Top-p" Margin="0,0,0,6" />
                                      <NumericUpDown Name="PART_RoleTopP" Classes="field" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" HorizontalAlignment="Stretch" Value="{Binding Profile.TopP, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                                    </StackPanel>
                                  </Grid>
                                  <TextBlock Classes="label" Text="回复长度上限（tokens）" Margin="0,6,0,0" />
                                  <NumericUpDown Classes="field" Minimum="1" Maximum="1000000" Increment="256" FormatString="0" HorizontalAlignment="Left" Width="180" Value="{Binding Profile.MaxTokens, Mode=TwoWay}" LostFocus="OnPersonaFormChanged" />
                                </StackPanel>
                              </Expander>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>
                      </TabControl>
                    </Grid>
                    <Border Name="PART_PersonaFooter" Grid.Row="1" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Button Name="PART_DuplicatePersona" Classes="outline" Content="复制" Padding="14,6" Click="OnDuplicatePersona" />
                        <Button Grid.Column="1" Name="PART_DeletePersona" Classes="textlink" Content="删除" Margin="12,0,0,0" Click="OnDeletePersona" />
                        <Button Grid.Column="3" Name="PART_SavePersona" Classes="pillprimary" Content="保存" Padding="18,6" Click="OnSavePersona" />
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </StackPanel>

              <StackPanel Name="PAGE_Search" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="联网搜索" />
                <TextBlock Classes="pagesubtitle"
                           Text="用于自定义模型的联网搜索能力，仅对支持工具调用的 BYOK 模型生效。" />

                <TextBlock Classes="section" Text="搜索服务" Margin="2,4,2,8" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,220">
                      <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="提供方" />
                        <TextBlock Name="PART_SearchProviderHint" Classes="hint" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Name="PART_SearchProvider" Classes="settingsinput"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <StackPanel Classes="fieldrow">
                      <TextBlock Classes="label" Text="接口地址" />
                      <TextBox Name="PART_SearchBaseUrl" Classes="settingsinput"
                               Text="{Binding WebSearchBaseUrl, Mode=TwoWay}"
                               PlaceholderText="留空使用默认" />
                    </StackPanel>
                    <Border Classes="divider" />
                    <StackPanel Classes="fieldrow">
                      <TextBlock Classes="label" Text="API Key" />
                      <Border Name="PART_SearchApiKeyFrame" Classes="input">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Grid.Column="0" Name="PART_SearchApiKey"
                                   Text="{Binding WebSearchApiKey, Mode=TwoWay}"
                                   PasswordChar="•" PlaceholderText="部分服务不需要"
                                   Background="Transparent" BorderThickness="0" Padding="0"
                                   VerticalContentAlignment="Center" />
                          <Button Grid.Column="1" Name="PART_RevealSearchKey" Classes="inlineaction"
                                  Width="28" Height="26" ToolTip.Tip="显示 / 隐藏">
                            <TextBlock Classes="icon" Text="&#xE7B3;" FontSize="12" />
                          </Button>
                        </Grid>
                      </Border>
                      <TextBlock Classes="hint" Text="保存在本机凭据库，不随对话上传。" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="结果" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,160">
                      <TextBlock Grid.Column="0" Classes="rowtitle" Text="每次搜索返回条数" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Name="PART_SearchMaxResults" Classes="settingsinput"
                                      Value="{Binding WebSearchMaxResults, Mode=TwoWay}"
                                      Minimum="1" Maximum="20" Increment="1" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,160">
                      <TextBlock Grid.Column="0" Classes="rowtitle" Text="单页正文最大字符数" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Name="PART_SearchMaxCharacters" Classes="settingsinput"
                                      Value="{Binding WebPageMaxCharacters, Mode=TwoWay}"
                                      Minimum="1000" Maximum="200000" Increment="1000" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Name="PART_SearchStatus" Classes="hint"
                                 Margin="0,0,16,0" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Name="PART_TestSearch" Classes="outline"
                              Content="测试连接" Padding="14,7" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Titles" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="会话标题" />
                <TextBlock Classes="pagesubtitle"
                           Text="为本地 BYOK 与 Work 对话自动生成简短标题。" />

                <TextBlock Classes="section" Text="自动生成" Margin="2,4,2,8" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="自动为新对话生成标题" />
                        <TextBlock Classes="hint" Text="发送首条消息后自动生成简短标题。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding AutoTitleEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Name="PART_TitleModelPanel" Classes="settingrow"
                          ColumnDefinitions="220,*" IsEnabled="{Binding AutoTitleEnabled}">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="标题生成使用模型" />
                        <TextBlock Classes="hint" Text="默认使用当前对话所使用的模型，每个新对话最多额外请求一次。" />
                      </StackPanel>
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <ComboBox Grid.Column="0" Name="PART_TitleModel"
                                  Classes="settingsinput"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TitleProviderModels}"
                                  SelectedItem="{Binding SelectedTitleProviderModel, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TitleProviderModelOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Classes="outline" Content="模型管理..."
                                Padding="12,7" Margin="10,0,0,0" Click="OnManageProviders" />
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_ImageGeneration" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="图像生成" />
                <TextBlock Classes="pagesubtitle"
                           Text="为 BYOK 文本对话配置可调用的图像生成服务。" />

                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="在对话中启用图像生成" />
                      <TextBlock Classes="hint" Text="开启后，支持工具调用的 BYOK 模型可调用此图像服务。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Name="PART_ImageGenerationEnabled"
                                  Classes="settingtoggle"
                                  IsChecked="{Binding ImageGenerationEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Classes="section" Text="生成参数" />
                <Border Classes="settingscard" IsEnabled="{Binding ImageGenerationEnabled}">
                  <StackPanel Classes="fieldrow" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Classes="label" Text="图像服务 / 模型" />
                        <ComboBox Name="PART_ImageGenerationModel" Classes="settingsinput"
                                  SelectionChanged="OnImageGenerationModelChanged">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageGenerationProviderModelOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="outline" Content="模型管理..."
                              Padding="12,7" VerticalAlignment="Bottom" Click="OnManageProviders" />
                    </Grid>
                    <Grid ColumnDefinitions="*,16,*">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="尺寸" />
                        <TextBox Classes="settingsinput"
                                 Text="{Binding ImageGenerationSize, Mode=TwoWay}"
                                 PlaceholderText="1024x1024" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="风格（可选）" />
                        <TextBox Classes="settingsinput"
                                 Text="{Binding ImageGenerationStyle, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Name="PART_ImageGenerationStatus" Classes="hint"
                                 Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Name="PART_TestImageGeneration" Classes="outline"
                              Content="测试连接" Padding="14,7" Click="OnTestImageGeneration" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Vision" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="视觉理解" />
                <TextBlock Classes="pagesubtitle"
                           Text="为不支持多模态的模型提供图像理解能力。" />

                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="启用外挂视觉" />
                      <TextBlock Classes="hint"
                                 Text="启用后，不支持多模态的模型将自动调用下方视觉模型解析图片。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                  IsChecked="{Binding VisionProxyEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Classes="section" Text="视觉模型" />
                <Border Classes="settingscard" IsEnabled="{Binding VisionProxyEnabled}">
                  <StackPanel Classes="fieldrow" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Classes="label" Text="选择模型" />
                        <ComboBox Name="PART_VisionModel" Classes="settingsinput"
                                  SelectionChanged="OnVisionModelChanged">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VisionProviderModelOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="outline" Content="模型管理..."
                              Padding="12,7" VerticalAlignment="Bottom" Click="OnManageProviders" />
                    </Grid>
                    <TextBlock Classes="hint"
                               Text="仅列出已启用、且具备视觉能力的服务与模型。可在「模型服务」中为模型勾选视觉能力。" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_PostProcessing" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="后处理" />
                <TextBlock Classes="pagesubtitle" Text="按需启用和配置后处理功能。" />
                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="自动替换" />
                      <TextBlock Classes="hint" Text="回答完成后，自动应用已启用的替换规则。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                  IsChecked="{Binding ResponsePostProcessingEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" AutomationProperties.Name="自动替换" />
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,20,0,8">
                  <TextBlock Classes="section" Text="替换规则" Margin="0" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Name="PART_MoveResponseRuleUp" Classes="outline" Content="上移" Padding="10,5" />
                  <Button Grid.Column="2" Name="PART_MoveResponseRuleDown" Classes="outline" Content="下移" Padding="10,5" Margin="6,0,0,0" />
                  <Button Grid.Column="3" Name="PART_DeleteResponseRule" Classes="outline" Content="删除" Padding="10,5" Margin="6,0,0,0" />
                  <Button Grid.Column="4" Name="PART_AddResponseRule" Classes="pillprimary" Content="添加" Padding="12,5" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Classes="hint" Text="按列表顺序依次处理，可添加自定义正则。" Margin="0,0,0,8" />
                <ListBox Name="PART_ResponseRules" MinHeight="80" MaxHeight="200" Margin="0,0,0,12"
                         Background="{DynamicResource Brush.Bg.Secondary}" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="pres:ResponseRegexRule">
                      <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="hint" Text="停用" IsVisible="{Binding !Enabled}" Margin="12,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border Name="PART_ResponseRuleEditor" Classes="settingscard" Padding="16" IsVisible="False">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Name="PART_ResponseRuleName" Classes="settingsinput" PlaceholderText="规则名称" />
                      <CheckBox Grid.Column="1" Name="PART_ResponseRuleEnabled" Content="启用" Margin="14,0,0,0" />
                    </Grid>
                    <TextBlock Name="PART_ResponseRuleExample" TextWrapping="Wrap" Margin="0,4" IsVisible="False" />
                    <Expander Name="PART_ResponseRegexEditor" Classes="settingssection" Header="编辑正则">
                      <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Classes="label" Text="正则表达式" />
                        <TextBox Name="PART_ResponseRulePattern" Classes="settingsinput" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="64" MaxHeight="144" FontFamily="{DynamicResource Font.Mono}" />
                        <TextBlock Classes="label" Text="替换为" />
                        <TextBox Name="PART_ResponseRuleReplacement" Classes="settingsinput" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="40" MaxHeight="100" FontFamily="{DynamicResource Font.Mono}"
                                 PlaceholderText="留空删除" />
                      </StackPanel>
                    </Expander>
                    <Button Name="PART_SaveResponseRule" Classes="pillprimary" Content="保存"
                            HorizontalAlignment="Right" Padding="14,6" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <TextBlock Name="PART_ResponseRuleError" Classes="hint" IsVisible="False"
                           Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Classes="section" Text="预览" />
                <Border Classes="settingscard" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="hint" Text="输入一段文字，查看替换效果。" />
                    <TextBox Name="PART_ResponsePreviewInput" Classes="settingsinput" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="78" MaxHeight="180" PlaceholderText="输入一段文字" />
                    <TextBlock Classes="label" Text="结果" />
                    <TextBox Name="PART_ResponsePreviewOutput" Classes="settingsinput" AcceptsReturn="True"
                             TextWrapping="Wrap" IsReadOnly="True" MinHeight="78" MaxHeight="180" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Sandbox" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="沙箱与文件" />
                <TextBlock Classes="pagesubtitle"
                           Text="让 BYOK 模型在对话中按需运行 Python 代码、读取本地文件。" />

                <TextBlock Classes="section" Text="沙箱环境" Margin="2,4,2,8" />
                <Border Name="PART_PythonToggleCard" Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="启用 Python 执行" />
                      <TextBlock Classes="hint" Text="BYOK 对话中按需运行 Python 代码并返回结果。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Name="PART_PythonToolEnabled"
                                  Classes="settingtoggle"
                                  IsChecked="{Binding PythonToolEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Name="PART_SandboxEnvironmentCard" Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Name="PART_SandboxStatus" Classes="rowtitle" />
                        <TextBlock Name="PART_SandboxDetail" Classes="hint" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Name="PART_ConfigureSandbox" Classes="outline"
                              Content="一键配置" Padding="14,7" VerticalAlignment="Center"
                              Click="OnConfigureSandbox" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Name="PART_PythonRuntimeStatus" Classes="rowtitle" />
                        <TextBlock Name="PART_PythonRuntimeDetail" Classes="hint" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Name="PART_ResetPythonRuntime" Classes="outline"
                              Content="重置环境" Padding="12,7" IsVisible="False"
                              Click="OnResetPythonRuntime" />
                    </Grid>
                    <StackPanel Classes="fieldrow">
                      <TextBlock Classes="label" Text="解释器路径" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="PART_PythonExecutable" Classes="settingsinput"
                                 Text="{Binding PythonToolExecutablePath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Name="PART_BrowsePython" Classes="outline"
                                Content="浏览..." Padding="14,7" Margin="8,0,0,0"
                                Click="OnBrowsePython" />
                      </Grid>
                    </StackPanel>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Name="PART_PiSidecarStatus" Classes="rowtitle" />
                        <TextBlock Name="PART_PiSidecarDetail" Classes="hint" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Name="PART_RemovePiSidecar" Classes="outline"
                              Content="移除" Padding="14,7" IsVisible="False"
                              Click="OnRemovePiSidecar" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Name="PART_PythonOptionsCard" Classes="settingscard"
                        IsEnabled="{Binding PythonToolEnabled}">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,16,*">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="超时（秒）" />
                        <NumericUpDown Classes="settingsinput"
                                       Value="{Binding PythonToolTimeoutSeconds, Mode=TwoWay}"
                                       Minimum="5" Maximum="300" Increment="5" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="输出上限（字符）" />
                        <NumericUpDown Classes="settingsinput"
                                       Value="{Binding PythonToolMaxOutputCharacters, Mode=TwoWay}"
                                       Minimum="2000" Maximum="100000" Increment="1000" />
                      </StackPanel>
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="联网访问" />
                        <TextBlock Classes="hint" Text="允许代码发起网络请求和安装第三方包。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding PythonToolAllowNetwork, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="文件工具（只读）" />
                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="启用只读文件工具" />
                      <TextBlock Classes="hint"
                                 Text="允许模型用 Read / Glob / Grep 读取、查找、搜索本地文件（只读，受 Python 的拒绝路径限制）。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                  IsChecked="{Binding FileToolsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Browser" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="浏览器使用" />
                <TextBlock Classes="pagesubtitle"
                           Text="让模型操作本机的 Chrome/Edge，需要 Kimi 浏览器扩展与本地服务。" />

                <TextBlock Classes="section" Text="连接" Margin="2,4,2,8" />
                <Border Name="PART_BrowserBridgeCard" Classes="settingscard"
                        x:DataType="vm:BrowserBridgeStatusViewModel">
                  <Border.Styles>
                    <Style Selector="Ellipse.statusdot">
                      <Setter Property="Width" Value="8" />
                      <Setter Property="Height" Value="8" />
                      <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
                    </Style>
                    <Style Selector="Ellipse.statusdot.ok">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                    </Style>
                    <Style Selector="Ellipse.statusdot.warn">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                    </Style>
                    <Style Selector="Ellipse.statusdot.err">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                    </Style>
                  </Border.Styles>
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Classes="statusdot"
                                 Classes.ok="{Binding IsOk}"
                                 Classes.warn="{Binding IsWarn}"
                                 Classes.err="{Binding IsError}"
                                 VerticalAlignment="Center" />
                        <TextBlock Classes="rowtitle" Text="{Binding StatusTitle}" />
                        <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding LastCheckedText}" />
                      </StackPanel>
                      <TextBlock Classes="hint" Margin="15,3,0,0" TextWrapping="Wrap"
                                 Text="{Binding StatusDetail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                      <Button Name="PART_BrowserSetupGuide" Classes="outline" Content="配置指引"
                              Padding="14,7" Click="OnOpenBrowserSetupGuide" />
                      <Button Classes="outline" Content="启动服务" Padding="14,7"
                              IsVisible="{Binding CanStart}" Command="{Binding StartCommand}" />
                      <Button Classes="primary" Content="检测" Padding="14,7"
                              IsEnabled="{Binding !IsBusy}"
                              Command="{Binding CheckCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="启用浏览器使用" />
                      <TextBlock Classes="hint" TextWrapping="Wrap"
                                 Text="开启后，MolaGPT Work 对话中可使用浏览器来执行操作。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Name="PART_BrowserToolEnabled"
                                  Classes="settingtoggle"
                                  IsChecked="{Binding BrowserToolEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Classes="section" Text="权限" />
                <Border Classes="settingscard" IsEnabled="{Binding BrowserToolEnabled}">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,180">
                      <TextBlock Classes="rowtitle" Text="操作审批" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Name="PART_BrowserPermission" Classes="settingsinput" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="16,0,16,6" TextWrapping="Wrap"
                               Text="打开页面、点击、填写等操作需审批，按网站记住；允许名单内的网站不再询问。" />
                    <TextBlock Classes="hint" Margin="16,0,16,14" TextWrapping="Wrap"
                               Text="下载、授权、支付等敏感操作每次都需审批，不受网站授权影响。" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="网站名单" />
                <Border Classes="settingscard" IsEnabled="{Binding BrowserToolEnabled}">
                  <StackPanel>
                    <StackPanel Classes="fieldrow">
                      <TextBlock Classes="label" Text="允许" />
                      <TextBox Classes="settingsinput" AcceptsReturn="True" MinHeight="58"
                               Text="{Binding BrowserAllowedHosts, Mode=TwoWay}"
                               Watermark="留空表示不限制网站" />
                    </StackPanel>
                    <StackPanel Classes="fieldrow">
                      <TextBlock Classes="label" Text="禁止" />
                      <TextBox Classes="settingsinput" AcceptsReturn="True" MinHeight="58"
                               Text="{Binding BrowserBlockedHosts, Mode=TwoWay}"
                               Watermark="例如 mail.google.com, admin.example.com" />
                    </StackPanel>
                    <StackPanel Classes="fieldrow">
                      <TextBlock Classes="label" Text="每次询问" />
                      <TextBox Classes="settingsinput" AcceptsReturn="True" MinHeight="58"
                               Text="{Binding BrowserSensitiveHosts, Mode=TwoWay}"
                               Watermark="例如网银、邮箱" />
                    </StackPanel>
                    <TextBlock Classes="hint" Margin="16,0,16,14" TextWrapping="Wrap"
                               Text="逗号分隔，含子域名。禁止优先于允许；「每次询问」不受「始终允许」影响。" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="操作记录" />
                <Border Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="hint" TextWrapping="Wrap" Margin="0,0,20,0"
                                 Text="浏览器操作记录，含 URL 等基本信息。" />
                      <Button Grid.Column="1" Name="PART_ClearBrowserActivity" Classes="outline"
                              Content="清空" Padding="14,7" VerticalAlignment="Center"
                              Click="OnClearBrowserActivity" />
                    </Grid>
                    <TextBlock Name="PART_BrowserActivityEmpty" Classes="hint" Margin="16,0,16,14"
                               Text="暂无记录。" />
                    <ItemsControl Name="PART_BrowserActivity" Margin="16,0,16,14">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="v:BrowserActivityRow">
                          <Grid ColumnDefinitions="76,Auto,*" Margin="0,3">
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Time}" />
                            <TextBlock Grid.Column="1" FontSize="12" Margin="0,0,10,0"
                                       Text="{Binding Action}"
                                       Foreground="{Binding Tone}" />
                            <TextBlock Grid.Column="2" Classes="muted" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="说明" />
                <Border Classes="settingscard">
                  <StackPanel Margin="16,12,16,14" Spacing="7">
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="本地服务由本机所有 Agent 共用，以上名单仅约束 MolaGPT 发出的操作。" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="浏览器使用在当前浏览器配置文件中进行，使用已登录的账号；浏览器中的任务标签归入 MolaGPT 标签组，可随时手动关闭。" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Approval" IsVisible="False">
                <TextBlock Classes="pagetitle" Text="审批与安全" />
                <TextBlock Classes="pagesubtitle"
                           Text="控制工具调用的审批策略，以及 Python 执行的自动放行与拦截规则。" />

                <TextBlock Classes="section" Text="所有本地工具" Margin="2,4,2,8" />
                <Border Classes="settingscard">
                  <StackPanel Classes="fieldrow">
                    <TextBlock Classes="label" Text="统一权限模式" />
                    <ComboBox Name="PART_ToolPermission" Classes="settingsinput" />
                    <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="写入工具限制在本次对话的工作目录内；只读工具在工作目录内自动放行，读取目录以外的文件时逐次询问，可按文件夹或磁盘记住。完全权限可跳过普通写入审批，但破坏性操作和 Python 包安装仍需确认。" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="已授权的工具" />
                <Border Classes="settingscard">
                  <StackPanel Classes="fieldrow">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="rowtitle" Text="始终允许（跳过审批）"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Name="PART_RevokeAll" Classes="textlink"
                              Content="全部撤销" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="在审批对话框中选择「始终允许」的工具，以及允许只读工具永久读取的文件夹或磁盘，都会在此列出，撤销后恢复审批。" />
                    <ItemsControl ItemsSource="{Binding AlwaysAllowedTools}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolGrantEntry">
                          <Border Classes="grantrow">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Display}"
                                         FontSize="{DynamicResource Font.Size.Small}"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="inlineaction"
                                      Click="OnRevokeGrant" Tag="{Binding Key}" ToolTip.Tip="撤销">
                                <TextBlock Classes="icon" Text="&#xE711;" FontSize="11" />
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Name="PART_NoGrants" Classes="hint" Text="暂无始终允许的工具。" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="按工具类型" />
                <Border Name="PART_PerToolPermissions" Classes="settingscard">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,180">
                      <TextBlock Classes="rowtitle" Text="图像生成" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Name="PART_ImagePermission" Classes="settingsinput" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,180">
                      <TextBlock Classes="rowtitle" Text="视觉理解" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Name="PART_VisionPermission" Classes="settingsinput" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,180">
                      <TextBlock Classes="rowtitle" Text="MCP 工具" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Name="PART_McpPermission" Classes="settingsinput" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,180">
                      <TextBlock Classes="rowtitle" Text="Python 执行" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Name="PART_PythonPermission" Classes="settingsinput" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="16,0,16,14" TextWrapping="Wrap"
                               Text="完全权限跳过普通审批；破坏性操作除外；全局设为完全权限时此处设置不生效。" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="Python 执行 — 放行与拦截规则" />
                <Border Classes="settingscard" IsEnabled="{Binding PythonToolEnabled}">
                  <StackPanel Classes="fieldrow" Spacing="12">
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="这些规则叠加在审批之上：仅用「额外允许导入」内的模块且无风险时自动放行；命中「禁止导入」或「禁止路径前缀」时直接拦截（完全权限模式下也拦截）。每行或逗号分隔一项。" />
                    <Grid ColumnDefinitions="*,16,*">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="额外允许导入" />
                        <TextBox Classes="settingsinput" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding PythonToolAllowedImports, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="禁止导入" />
                        <TextBox Classes="settingsinput" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding PythonToolDeniedImports, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,16,*">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="允许路径前缀" />
                        <TextBox Classes="settingsinput" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding PythonToolAllowedPathPrefixes, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="禁止路径前缀" />
                        <TextBox Classes="settingsinput" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding PythonToolDeniedPathPrefixes, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Mcp" IsVisible="False">
                <StackPanel Name="PART_McpOverview">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="pagetitle" Text="MCP 服务器" />
                      <TextBlock Classes="pagesubtitle"
                                 Text="接入 Model Context Protocol 服务器，为对话扩展外部工具。" />
                    </StackPanel>
                    <Button Grid.Column="1" Name="PART_AddMcp" Classes="pillprimary"
                            Content="添加服务器" Padding="16,8" VerticalAlignment="Top" />
                  </Grid>

                  <TextBlock Classes="section" Text="HTTP 服务器" Margin="2,4,2,8" />
                  <ItemsControl Name="PART_McpServers">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:McpServerEntry">
                        <Border Classes="providercard">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                      IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,9,0"
                                      ToolTip.Tip="是否启用" />
                            <StackPanel Grid.Column="1" Spacing="3">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Url}"
                                         FontSize="{DynamicResource Font.Size.XSmall}"
                                         Foreground="{DynamicResource Brush.Text.Muted}"
                                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="10,0,0,0">
                              <Button Classes="inlineaction" Click="OnEditMcp" Tag="{Binding}"
                                      ToolTip.Tip="编辑">
                                <TextBlock Classes="icon" Text="&#xE70F;" FontSize="13" />
                              </Button>
                              <Button Classes="inlineaction" Click="OnDeleteMcp" Tag="{Binding}"
                                      ToolTip.Tip="删除">
                                <TextBlock Classes="icon" Text="&#xE74D;" FontSize="13" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Name="PART_NoMcpServers" Classes="emptystate">
                    <TextBlock Classes="hint" Text="尚未添加任何 MCP 服务器。"
                               HorizontalAlignment="Center" />
                  </Border>

                  <Border Background="{DynamicResource Brush.Primary.Soft}"
                          BorderBrush="{DynamicResource Brush.Primary.Border}"
                          BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}"
                          Padding="12,10" Margin="0,12,0,0">
                    <TextBlock Classes="hint" Margin="0"
                               Text="MCP 工具对支持工具调用的自定义模型可用。" />
                  </Border>
                </StackPanel>

                <StackPanel Name="PART_McpEditor" IsVisible="False">
                  <TextBlock Name="PART_McpEditorTitle" Classes="pagetitle" />
                  <TextBlock Classes="pagesubtitle"
                             Text="仅支持 Streamable HTTP 服务器。" />

                  <Border Classes="settingscard" Padding="16">
                    <StackPanel Spacing="14">
                      <StackPanel>
                        <TextBlock Classes="label" Text="名称" />
                        <TextBox Name="PART_McpName" Classes="settingsinput"
                                 PlaceholderText="例如 文档工具" />
                      </StackPanel>

                      <StackPanel>
                        <TextBlock Classes="label" Text="服务器地址" />
                        <TextBox Name="PART_McpUrl" Classes="settingsinput"
                                 PlaceholderText="https://example.com/mcp" />
                        <TextBlock Classes="hint"
                                   Text="远程地址使用 https://；本地服务器可用 http://localhost。" />
                      </StackPanel>

                      <Grid ColumnDefinitions="180,14,*">
                        <StackPanel Grid.Column="0">
                          <TextBlock Classes="label" Text="请求头名称" />
                          <TextBox Name="PART_McpHeader" Classes="settingsinput"
                                   Text="Authorization" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Classes="label" Text="Token" />
                          <Border Classes="input">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBox Grid.Column="0" Name="PART_McpToken" PasswordChar="•"
                                       VerticalContentAlignment="Center" />
                              <Button Grid.Column="1" Name="PART_RevealMcpToken" Classes="inlineaction"
                                      Width="28" Height="26" ToolTip.Tip="显示 / 隐藏">
                                <TextBlock Classes="icon" Text="&#xE7B3;" FontSize="12" />
                              </Button>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                          <TextBlock Classes="rowtitle" Text="启用此服务器" />
                          <TextBlock Classes="hint" Text="启用后，其工具会加入支持工具调用的对话。" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Name="PART_McpEnabled"
                                      Classes="settingtoggle" IsChecked="True"
                                      VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Name="PART_McpStatus" Classes="hint" Margin="2,12,2,0" />
                  <TextBlock Name="PART_McpError" Classes="hint" IsVisible="False"
                             Foreground="{DynamicResource Brush.Error}" Margin="2,12,2,0" />

                  <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <Button Grid.Column="0" Name="PART_TestMcp" Classes="outline"
                            Content="测试连接" Padding="16,7" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Name="PART_CancelMcp" Classes="outline"
                              Content="取消" Padding="18,7" />
                      <Button Name="PART_SaveMcp" Classes="pillprimary"
                              Content="保存" Padding="18,7" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>

              <StackPanel Name="PAGE_Agent"
                          IsVisible="False"
                          x:DataType="agents:AgentBridgeStatusViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Classes="pagetitle" Text="Agent Bridge" />
                    <TextBlock Classes="pagesubtitle" Text="Bridge 与移动端连接。" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="outline"
                          Padding="12,6"
                          Margin="12,0,0,0"
                          VerticalAlignment="Top"
                          Command="{Binding RefreshCommand}"
                          Content="刷新" />
                </Grid>

                <TextBlock Classes="section" Text="Bridge" Margin="2,4,2,8" />
                <Border Classes="settingscard" Margin="0,0,0,10">
                  <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                      <TextBlock Classes="rowtitle" Text="远程桥接" />
                      <TextBlock Classes="hint"
                                 Text="开启后，本机 Agent 会话经云端中转同步到你的手机以供远程查看与控制。默认关闭。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="outline"
                            Padding="18,7"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleBridgeCommand}"
                            Content="{Binding BridgeToggleLabel}" />
                  </Grid>
                </Border>

                <Border Classes="settingscard">
                  <Grid Classes="settingrow" ColumnDefinitions="*,*,*,*">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="hint" Margin="0" Text="状态" />
                      <TextBlock Classes="rowtitle" Margin="0,4,0,0" Text="{Binding BridgeStatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="hint" Margin="0" Text="会话" />
                      <TextBlock Classes="rowtitle" Margin="0,4,0,0" Text="{Binding SessionCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="hint" Margin="0" Text="投影" />
                      <TextBlock Classes="rowtitle" Margin="0,4,0,0" Text="{Binding ProjectedSessionCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                      <TextBlock Classes="hint" Margin="0" Text="队列" />
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Classes="rowtitle" Text="{Binding ActiveProjectionCount}" />
                        <TextBlock Classes="rowtitle" Text="+" />
                        <TextBlock Classes="rowtitle" Text="{Binding QueuedProjectionCount}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Classes="section" Text="移动端" />
                <Border Classes="settingscard">
                  <StackPanel Classes="fieldrow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <TextBlock Classes="rowtitle" Text="已连接设备" />
                      <TextBlock Grid.Column="1" Classes="hint" Margin="0" Text="{Binding MobileDeviceCount}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="暂无设备" IsVisible="{Binding !HasMobileDevices}" />
                    <ItemsControl ItemsSource="{Binding MobileDevices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="relay:RelayMobileDevice">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Classes="rowtitle" Text="{Binding Name, TargetNullValue=移动端}" />
                            <TextBlock Grid.Column="1" Classes="hint" Margin="12,0,0,0" Text="{Binding Id}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="会话" />
                <Border Classes="settingscard">
                  <ScrollViewer MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:AgentSessionStateDto">
                          <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                            <StackPanel Grid.Column="0">
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="●"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           FontSize="11"
                                           Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="待处理"
                                           IsVisible="{Binding NeedsAttention}" />
                                <TextBlock Grid.Column="1" Classes="rowtitle" Text="{Binding Title}" />
                              </Grid>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="hint" Margin="0" Text="{Binding BackendId, Converter={StaticResource AgentSessionLabel}, ConverterParameter=backend}" />
                                <TextBlock Classes="hint" Margin="0" Text=" · " />
                                <TextBlock Classes="hint" Margin="0" Text="{Binding ModeLabel}" />
                                <TextBlock Classes="hint" Margin="0" Text=" · " />
                                <TextBlock Classes="hint" Margin="0" Text="{Binding WorkingDirectory}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Classes="hint"
                                       Margin="12,0,0,0"
                                       Text="{Binding Phase, Converter={StaticResource AgentSessionLabel}}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </StackPanel>

              <StackPanel Name="PAGE_Skills" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Classes="pagetitle" Text="技能" />
                    <TextBlock Classes="pagesubtitle"
                               Text="管理模型可调用的技能。" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                              VerticalAlignment="Top">
                    <Button Classes="inlineaction" Click="OnRefreshSkills" Height="36"
                            ToolTip.Tip="刷新技能列表">
                      <TextBlock Classes="icon" Text="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button Classes="outline" Content="打开技能目录" Padding="14,8"
                            Click="OnOpenSkillsDirectory" />
                    <Button Name="PART_ImportSkill" Classes="pillprimary" Content="导入技能"
                            Padding="14,8" Click="OnImportSkill" />
                  </StackPanel>
                </Grid>

                <TextBlock Name="PART_SkillStatus" Classes="hint" Margin="2,0,2,14"
                           IsVisible="False" TextWrapping="Wrap" />

                <TextBlock Classes="section" Text="内置技能" Margin="2,4,2,8" />
                <ItemsControl Name="PART_BuiltinSkills"
                              ItemTemplate="{StaticResource SkillCardTemplate}" />
                <Border Name="PART_NoBuiltinSkills" Classes="emptystate">
                  <TextBlock Classes="hint" Text="暂无内置技能。"
                             HorizontalAlignment="Center" />
                </Border>

                <TextBlock Classes="section" Text="自定义技能" />
                <ItemsControl Name="PART_UserSkills"
                              ItemTemplate="{StaticResource SkillCardTemplate}" />
                <Border Name="PART_NoUserSkills" Classes="emptystate">
                  <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                             Text="暂无自定义技能。&#x000A;导入包含 SKILL.md 的 .zip，或从技能目录加载。" />
                </Border>
              </StackPanel>

              <!-- 记忆。DataContext is the window's SettingsViewModel for the
                   switches; the entry list binds to PART_MemoryBody's own
                   MemoryPageViewModel, set in code-behind. -->
              <StackPanel Name="PAGE_Memory" IsVisible="False">
                <StackPanel Name="PART_MemoryBody" x:DataType="vm:MemoryPageViewModel">
                  <StackPanel Name="PART_MemoryOverview" IsVisible="{Binding IsOverview}">
                    <!-- 页面标题 + 右上角操作，抄 PAGE_Providers 的骨架。两个按钮原先
                         吊在「记忆主题」下面自成一行，于是标题、按钮、分组名三层挤在
                         一起互相打架。 -->
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="pagetitle" Text="记忆" />
                        <TextBlock Classes="pagesubtitle"
                                   Text="记忆将从对话中学习用户偏好，让后续回复更贴合用户。MolaGPT Chat 对话不参与本地记忆。" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Classes="outline" Content="立即整理" Padding="14,8"
                                Click="OnMemoryConsolidate" IsEnabled="{Binding !IsWriteLocked}" />
                        <Button Name="PART_MemoryNewTopic" Classes="pillprimary" Content="+ 主题" Padding="14,8"
                                Click="OnMemoryNewTopic" IsEnabled="{Binding !IsWriteLocked}" />
                      </StackPanel>
                    </Grid>
                    <Border Name="PART_MemoryMasterSwitch" Classes="settingscard" Margin="0,0,0,20">
                      <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                          <TextBlock Classes="rowtitle" Text="启用本地记忆" />
                          <TextBlock Classes="hint" Text="关闭后后续将不会记录记忆数据。" />
                        </StackPanel>
                        <ToggleButton Name="PART_MemoryMasterToggle" Grid.Column="1" Classes="settingtoggle"
                                      IsChecked="{Binding #PAGE_Memory.DataContext.MemoryEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <!-- 个人资料。The one part of memory the user declares rather
                         than the model learns, so it sits above the learned
                         topics and is never in the 待确认 flow. 称呼 is also what
                         氛围模式 的「沿用个人资料」reads. -->
                    <Border Name="PART_MemoryConsolidating" Classes="settingscard" Margin="0,0,0,18"
                            IsVisible="{Binding IsConsolidating}">
                      <Grid Classes="settingrow" ColumnDefinitions="*,Auto" ColumnSpacing="22">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="rowtitle" Text="正在整理记忆" />
                          <TextBlock Classes="hint" Text="整理完成后将通过通知提示您。" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" MinWidth="0" Height="4"
                                     ClipToBounds="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <TextBlock Classes="section" Text="个人资料" Margin="12,22,0,10" />
                    <Border Classes="settingscard">
                      <StackPanel>
                        <Grid Classes="settingrow" ColumnDefinitions="220,*">
                          <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <TextBlock Classes="rowtitle" Text="称呼" />
                              <!-- 同 整理模型 那一颗：这一格空着，「沿用个人资料」就没东西可用。 -->
                              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Error}"
                                       VerticalAlignment="Center" IsVisible="{Binding ProfileNeedsName}" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="模型如何称呼你；可在氛围模式中使用该称呼。" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Name="PART_MemoryProfileName" Classes="field" MaxLength="40"
                                   VerticalAlignment="Center" PlaceholderText="未填写"
                                   Text="{Binding ProfileName, Mode=TwoWay}" LostFocus="OnMemoryProfileCommit" />
                        </Grid>
                        <Border Classes="divider" />
                        <Grid Classes="settingrow" ColumnDefinitions="220,*">
                          <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Classes="rowtitle" Text="职业" />
                            <TextBlock Classes="hint" Text="用于对话模式中。" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Classes="field" MaxLength="60" VerticalAlignment="Center"
                                   PlaceholderText="未填写"
                                   Text="{Binding ProfileOccupation, Mode=TwoWay}" LostFocus="OnMemoryProfileCommit" />
                        </Grid>
                        <Border Classes="divider" />
                        <Grid Classes="settingrow" ColumnDefinitions="220,*">
                          <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Classes="rowtitle" Text="所在地" />
                            <TextBlock Classes="hint" Text="留空则可能由模型自主判断。" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Classes="field" MaxLength="60" VerticalAlignment="Center"
                                   PlaceholderText="未填写"
                                   Text="{Binding ProfileLocation, Mode=TwoWay}" LostFocus="OnMemoryProfileCommit" />
                        </Grid>
                        <Border Classes="divider" />
                        <Grid Classes="settingrow" ColumnDefinitions="220,*">
                          <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Classes="rowtitle" Text="回复语言" />
                            <TextBlock Classes="hint" Text="留空则跟随系统。" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Classes="field" MaxLength="40" VerticalAlignment="Center"
                                   PlaceholderText="跟随系统"
                                   Text="{Binding ProfileLanguage, Mode=TwoWay}" LostFocus="OnMemoryProfileCommit" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- 分组名就是这一段唯一的标题层。原先「记忆主题」和「关于你」用的是
                         同一个 section 样式、相隔十来个像素，读起来是两个平级标题在打架;
                         页面标题已经写着「记忆」，中间那一层是多余的。 -->
                    <ItemsControl Name="PART_MemoryGroups" ItemsSource="{Binding Groups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalMemoryGroupRow">
                          <StackPanel>
                            <TextBlock Classes="section" Text="{Binding Name}" Margin="12,22,0,10" />
                            <ItemsControl ItemsSource="{Binding Topics}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalMemoryTopicRow">
                                  <StackPanel>
                                    <!-- 分隔线在行的上面而不是下面：最后一行下面不再拖一条
                                         悬空的线，分组之间也就不会出现双线。 -->
                                    <Border Classes="divider" />
                                    <Button Classes="textlink" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="12,15" Click="OnMemoryTopicOpen">
                                      <Grid ColumnDefinitions="1.2*,2*,110" ColumnSpacing="18">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Summary}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding UpdatedLabel}" VerticalAlignment="Center" />
                                      </Grid>
                                    </Button>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="emptystate" IsVisible="{Binding IsEmpty}">
                      <TextBlock Classes="hint" Text="暂未产生记忆" HorizontalAlignment="Center" />
                    </Border>
                                      <StackPanel IsVisible="{Binding HasCandidates}">
                    <TextBlock Classes="section" Text="待确认" Margin="12,22,0,10" />
                    <ItemsControl ItemsSource="{Binding Candidates}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="repo:LocalMemoryCandidateRow">
                          <Border Classes="settingscard" Margin="0,0,0,8">
                            <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                              <StackPanel Grid.Column="0" Margin="0,0,14,0" Spacing="4">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Classes="hint" Text="{Binding Quote}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                          VerticalAlignment="Center">
                                <Button Classes="textlink" Content="确认" Click="OnMemoryCandidateAccept"
                                        IsEnabled="{Binding !#PART_MemoryBody.DataContext.IsWriteLocked}" />
                                <Button Classes="textlink" Content="忽略" Click="OnMemoryCandidateIgnore"
                                        IsEnabled="{Binding !#PART_MemoryBody.DataContext.IsWriteLocked}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>


                    <Expander Header="文件与索引" HorizontalAlignment="Stretch" Margin="0,16,0,0">
                                        <Border Classes="settingscard">
                    <StackPanel>
                      <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                          <TextBlock Classes="rowtitle" Text="记忆文件夹" />
                          <TextBlock Classes="hint" Text="{Binding MemoryFolder}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="outline" Content="打开" Padding="12,6"
                                Click="OnMemoryOpenFolder" VerticalAlignment="Center" />
                      </Grid>
                      <Border Classes="divider" />
                      <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                          <TextBlock Classes="rowtitle" Text="历史对话索引" />
                          <TextBlock Classes="hint" Text="用于检索历史对话，删除后可重新建立，不影响记忆内容。" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="outline" Content="重建" Padding="12,6"
                                Click="OnMemoryRebuildIndex" IsEnabled="{Binding !IsWriteLocked}"
                                VerticalAlignment="Center" />
                      </Grid>
                      <Border Classes="divider" />
                      <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                          <TextBlock Classes="rowtitle" Text="清除全部记忆" />
                          <TextBlock Classes="hint" Text="删除记忆文件和待确认内容，历史消息不会再次用于整理。" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="outline" Content="清除" Padding="12,6"
                                Foreground="{DynamicResource Brush.Error}"
                                Click="OnMemoryClearAll" IsEnabled="{Binding !IsWriteLocked}" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>

                    </Expander>
                  </StackPanel>

                  <StackPanel Name="PART_MemoryDetail" IsVisible="{Binding IsDetailVisible}">
                    <Button Name="PART_MemoryBack" Classes="textlink" Content="‹ 记忆" Click="OnMemoryTopicBack"
                            HorizontalAlignment="Left" Margin="0,0,0,24" />
                    <StackPanel IsVisible="{Binding !IsEditingTopic}">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                        <TextBlock Classes="pagetitle" Text="{Binding SelectedTopic.Title}" Margin="0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                          <Button Name="PART_MemoryEditTopic" Classes="textlink" Content="编辑" Click="OnMemoryTopicEdit"
                                  IsEnabled="{Binding !IsWriteLocked}" />
                          <Button Classes="outline" Content="删除主题" Click="OnMemoryTopicDelete"
                                  IsEnabled="{Binding !IsWriteLocked}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="hint" Text="最近更新" />
                      <TextBlock Text="{Binding SelectedTopic.UpdatedLabel}" Margin="0,6,0,22" />
                      <TextBlock Classes="hint" Text="摘要" />
                      <TextBlock Text="{Binding SelectedTopic.Summary}" TextWrapping="Wrap" Margin="0,6,0,22" />
                      <TextBlock Classes="hint" Text="详细记录" Margin="0,0,0,10" />
                      <ItemsControl Name="PART_MemoryEntries" ItemsSource="{Binding SelectedTopic.Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LocalMemoryEntryRow">
                            <Grid ColumnDefinitions="16,*,Auto" Margin="0,0,0,12">
                              <TextBlock Text="•" Margin="0,2,0,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,12,0"
                                         IsVisible="{Binding !IsEditing}" />
                              <TextBox Grid.Column="1" Classes="field" Text="{Binding Text, Mode=TwoWay}" TextWrapping="Wrap"
                                       AcceptsReturn="False" MaxLength="300" Margin="0,0,12,0" IsVisible="{Binding IsEditing}" />
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                <Button Classes="textlink" Content="编辑" Click="OnMemoryEntryEdit" IsVisible="{Binding !IsEditing}"
                                        IsEnabled="{Binding !#PART_MemoryBody.DataContext.IsWriteLocked}" />
                                <Button Classes="textlink" Content="保存" Click="OnMemoryEntryCommit" IsVisible="{Binding IsEditing}"
                                        IsEnabled="{Binding !#PART_MemoryBody.DataContext.IsWriteLocked}" />
                                <Button Classes="textlink" Content="删除" Click="OnMemoryEntryDelete"
                                        IsEnabled="{Binding !#PART_MemoryBody.DataContext.IsWriteLocked}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,18,0,0">
                        <TextBox Classes="field" Text="{Binding NewEntryText, Mode=TwoWay}" Watermark="补充一条记录" MaxLength="300" />
                        <Button Grid.Column="1" Classes="outline" Content="添加" Click="OnMemoryAdd"
                                IsEnabled="{Binding !IsWriteLocked}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Name="PART_MemoryTopicEditor" IsVisible="{Binding IsEditingTopic}" Spacing="14">
                      <TextBlock Classes="section" Text="编辑主题" Margin="0" />
                      <ComboBox ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding TopicGroup, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                      <TextBox Name="PART_MemoryTopicTitle" Classes="field" Text="{Binding TopicTitle, Mode=TwoWay}" Watermark="主题名称" MaxLength="60" />
                      <TextBox Classes="field" Text="{Binding TopicSummary, Mode=TwoWay}" Watermark="摘要" MaxLength="240" />
                      <TextBox Classes="field" Text="{Binding NewEntryText, Mode=TwoWay}" Watermark="详细记录" MaxLength="300"
                               IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNull}}" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Name="PART_MemoryTopicSave" Classes="outline" Content="保存" Click="OnMemoryTopicSave" />
                        <Button Classes="textlink" Content="取消" Click="OnMemoryTopicCancel" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding Status}" Margin="0,14,0,0" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Expander Name="PART_MemorySettings" Header="记忆设置" HorizontalAlignment="Stretch" Margin="0,20,0,0">
                  <StackPanel>
                <TextBlock Classes="section" Text="功能" />
                <Border Classes="settingscard" IsEnabled="{Binding MemoryEnabled}">
                  <StackPanel>
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="使用记忆" />
                        <TextBlock Classes="hint" Text="将记忆用于对话，并允许模型更新记忆。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding MemoryUseEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="检索历史对话" />
                        <TextBlock Classes="hint" Text="允许模型检索本机的 MolaGPT Work 历史对话。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding MemoryRecallEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="自动整理" />
                        <TextBlock Classes="hint" Text="从新对话中提取值得长期保留的信息，可能产生额外用量。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding MemoryAutoLearnEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="220,*"
                          IsEnabled="{Binding MemoryAutoLearnEnabled}">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Classes="rowtitle" Text="整理模型" />
                          <!-- 未选模型 = 自动整理压根不会运行。这个点就是那句话的全部提示。 -->
                          <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Error}"
                                   VerticalAlignment="Center" IsVisible="{Binding MemoryNeedsModel}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="需单独选择，不随当前对话切换。未选择时不会自动整理。" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="settingsinput"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                PlaceholderText="选择模型"
                                ItemsSource="{Binding MemoryProviderModels}"
                                SelectedItem="{Binding SelectedMemoryProviderModel, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:MemoryProviderModelOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="220,*">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Classes="rowtitle" Text="记忆上限" />
                        <TextBlock Classes="hint" Text="对话中最多使用的记忆量，数量过多会造成用量上升。" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Name="PART_MemoryBudget" Classes="settingsinput"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                SelectionChanged="OnMemoryBudgetChanged">
                        <ComboBoxItem Content="少" Tag="1000" />
                        <ComboBoxItem Content="标准" Tag="2000" />
                        <ComboBoxItem Content="多" Tag="4000" />
                        <ComboBoxItem Content="最多" Tag="8000" />
                      </ComboBox>
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="settingrow" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Classes="rowtitle" Text="允许写入敏感信息" />
                        <TextBlock Classes="hint" Text="关闭后，密钥、证件号等敏感信息将不会写入记忆。" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="settingtoggle"
                                    IsChecked="{Binding MemoryAllowSensitive, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>

                  </StackPanel>
                </Expander>
              </StackPanel>
            </Panel>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>

  <Window.Styles>
    <!-- Pages are stacked in one Panel and swapped by IsVisible, so switching
         nav items used to be a hard cut between two dense pages of controls —
         at that density the eye cannot tell a page change from a redraw. One
         selector covers all thirteen. -->
    <Style Selector="Panel#PART_Pages > StackPanel[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.19" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="10" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.pagesubtitle">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,18" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="Margin" Value="2,22,2,8" />
    </Style>
    <Style Selector="TextBlock.rowtitle">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <!-- Stated rather than inherited: the theme's TextBlock.label is
           Text.Secondary, and settings captions have always been primary. -->
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- TextBlock.hint and Border.settingscard now live in Theme/Controls.axaml:
         the role dialogs are separate windows and cannot borrow a rule defined
         here. Values are unchanged. -->
    <Style Selector="Grid.settingrow">
      <Setter Property="Margin" Value="16,13" />
    </Style>
    <Style Selector="StackPanel.fieldrow">
      <Setter Property="Margin" Value="16,13" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style Selector="ListBoxItem.navgroup">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.XSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="Margin" Value="2,15,2,5" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:not(.navgroup)">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="ListBoxItem:not(.navgroup):pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.HoverOverlay}" />
    </Style>
    <Style Selector="ListBoxItem:not(.navgroup):selected /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:not(.navgroup):selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
      侧栏层级。分组标题和条目原来差 12 对 14 两级字号、左边缘还完全对齐，
      在中文字面上几乎读成同一种行；十八行又放不进默认窗口高度，最后两项
      (Agent Bridge、技能) 被滚到视野外——想找技能的人第一眼看不到它。

      标题降到 11 并加字距，条目行高压到 33，两件事一起做：层级拉开，整份
      导航一屏放得下（默认 704 高下约 617 < 652，字号放大档位仍会滚动）。
      这几条写在通用规则之后，只命中 PART_Nav，技能/模型等列表不受影响。
    -->
    <Style Selector="ListBox#PART_Nav ListBoxItem.navgroup">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Margin" Value="0,16,0,5" />
      <Setter Property="Padding" Value="12,0" />
      <!-- Text.Muted 和 Text.Secondary 在这套 token 里几乎是同一个灰
           (#707A86 / #6C757D)，靠颜色分不出主次，只能再压一档不透明度。 -->
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ListBox#PART_Nav ListBoxItem:not(.navgroup)">
      <Setter Property="Padding" Value="12,6" />
      <!-- 条目是这一栏的主体，原来和分组标题同为灰色，两级只差 2px 字号。 -->
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- 选中态原本是「浅粉底 + 1px 粉框 + 粉字」三重信号，边框还会把文字
         整体挤 1px，切页时看得出抖动。底色加字色已经够认。 -->
    <Style Selector="ListBox#PART_Nav ListBoxItem:selected /template/ Border#PART_Root">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 重申一遍粉色：上面那条把未选中条目改成了 Text.Primary，而同优先级的
         setter 谁后生效谁赢；不写这条就得指望 :selected 总是后激活。 -->
    <Style Selector="ListBox#PART_Nav ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="Slider /template/ Thumb#thumb">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="Slider:pointerover /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>
    <Style Selector="Slider:pointerover /template/ Thumb#thumb">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>
    <Style Selector="ToggleButton.settingtoggle">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Track"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- 轨道 22、内边距 3、圆点 16:圆点中心落在 3 逻辑像素 = 4.5 物理
                 像素(150% 缩放)。布局取整会把 4.5 上取成 5,于是上间隙 5、下
                 间隙 4,总间隙 9 物理像素是奇数,任何整数像素布局都无法均分。
                 关掉圆点自身的取整,保留 4.5 的亚像素位置,上下各得半行抗锯齿
                 → 视觉上真正垂直居中。 -->
            <Ellipse Name="PART_Thumb"
                     Width="16" Height="16"
                     UseLayoutRounding="False"
                     Fill="{DynamicResource Brush.Bg.Elevated}"
                     HorizontalAlignment="Left" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.settingtoggle:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="ToggleButton.settingtoggle:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>
    <Style Selector="ToggleButton.settingtoggle:checked /template/ Ellipse#PART_Thumb">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBox.settingsinput">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="TextBox.settingsinput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="Grid#PART_PersonaEditor TextBox[AcceptsReturn=True]">
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="ListBox#PART_PersonaList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.personacard">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.personacard">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
    </Style>
    <Style Selector="ComboBox.settingsinput">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.settingsinput">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The spin box forwards focus to its inner TextBox, which the theme no
         longer gives a focus ring, so the field border has to show it. -->
    <Style Selector="NumericUpDown.settingsinput:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.input">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Border.input:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="Border.providercard">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.providereditcard">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.detectedmodelrow">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.countpill">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="Border.emptystate">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.grantrow">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.pillprimary">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pillprimary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>
    <Style Selector="Button.textlink">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <!-- 二级页面的返回。箭头、文案和尺寸都由样式给，调用方只补一句
         ToolTip 说明退回到哪一页；角色页原先自己画了一个 textlink 版本，
         读起来像正文里的链接，而不是和模型服务同一件导航控件。 -->
    <Style Selector="Button.back">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Content" Value="返回" />
      <Setter Property="ContentTemplate">
        <DataTemplate x:DataType="x:String">
          <StackPanel Classes="inlinerow" Spacing="5">
            <TextBlock Classes="icon" Text="&#xE72B;" FontSize="13" />
            <TextBlock Text="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </Setter>
    </Style>
  </Window.Styles>
</v:MolaContentWindow>
