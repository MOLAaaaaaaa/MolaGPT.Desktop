<views:MolaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MolaGPT.App.Views"
        x:Class="MolaGPT.App.Views.BridgePrivacyWindow"
        Title="隐私说明"
        Width="460" Height="380"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}">
  <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Name="PART_Header"
                PointerPressed="OnHeaderPointerPressed"
                Padding="22,16"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,0,0,1">
          <TextBlock Text="启用远程桥接 · 隐私说明"
                     FontSize="{DynamicResource Font.Size.Heading}"
                     FontWeight="Bold" />
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18,24,0">
          <TextBlock TextWrapping="Wrap"
                     LineHeight="23"
                     Classes="secondary"
                     Text="启用后，MolaGPT 会把本机 Agent 会话（Claude Code / Codex）的状态、对话内容、思考、工具调用与结果，经云端同步到登录同一账号的 MolaGPT App 上以供远程查看与控制。" />
          <TextBlock TextWrapping="Wrap"
                     Margin="0,14,0,0"
                     LineHeight="22"
                     Classes="secondary"
                     Text="· 数据仅同账号设备可读；&#x0a;· 仅在桥接开启期间同步，关闭后桌面立即标记离线并停止上报；&#x0a;· 会话内容会暂存在中转服务器以支持断线重放，请勿在远程会话中处理高度敏感信息。" />
          <TextBlock TextWrapping="Wrap"
                     Margin="0,14,0,0"
                     FontSize="12"
                     Classes="muted"
                     Text="默认关闭。可以随时在「设置 → Agent Bridge」中停用。" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,20,24,22">
          <Button Name="PART_Cancel" Classes="outline" Padding="16,8" Content="取消" />
          <Button Name="PART_Confirm" Classes="pillprimary" Padding="16,8" Margin="10,0,0,0" Content="我已知晓，启用" />
        </StackPanel>
  </Grid>
</views:MolaWindow>
