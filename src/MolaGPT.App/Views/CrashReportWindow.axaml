<views:MolaContentWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MolaGPT.App.Views"
        x:Class="MolaGPT.App.Views.CrashReportWindow"
        Title="MolaGPT 崩溃报告"
        Icon="avares://MolaGPT.Desktop/Assets/app.ico"
        Width="480"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}">

  <!-- 与 UpdateWindow 同一套开放式页眉：图标 + 标题 + 关闭 -->
  <views:MolaContentWindow.Header>
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,28,28,8" Background="Transparent">
      <TextBlock Classes="icon" Text="&#xE783;" FontSize="18"
                 Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Name="PART_Title" Text="MolaGPT 意外退出"
                 FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="2" Name="PART_HeaderClose" Classes="headericon" ToolTip.Tip="关闭">
        <TextBlock Classes="icon" Text="&#xE711;" />
      </Button>
    </Grid>
  </views:MolaContentWindow.Header>

  <Grid Margin="28,0,28,28" RowDefinitions="Auto,*,Auto,Auto,Auto">
    <TextBlock Grid.Row="0" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,16"
               Text="很抱歉打断了你的工作。报告只保存在本机，不会自动上传。" />

    <!-- 固定槽位内切换「错误概览 / 技术详情」，窗口尺寸全程不变，不触发 DXGI 重绘跳变 -->
    <Panel Grid.Row="1">
      <Border Name="PART_ErrorCard" Classes="errorcard">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Bottom" Name="PART_Meta" Classes="cardmeta" Margin="0,10,0,0" />
          <Grid RowDefinitions="Auto,*">
            <SelectableTextBlock Grid.Row="0" Name="PART_ErrorType" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" Name="PART_MessageScroll" Margin="0,5,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <SelectableTextBlock Name="PART_Message" Classes="cardbody" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <TextBox Name="PART_Details" Classes="field" IsVisible="False"
               IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="{DynamicResource Font.Mono}" FontSize="12"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Panel>

    <!-- 工具行：左侧切视图，右侧低权重的报告操作 -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
      <Button Name="PART_DetailsToggle" Classes="textlink">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Name="PART_DetailsBackIcon" Classes="icon" Text="&#xE72B;" FontSize="11"
                     VerticalAlignment="Center" IsVisible="False" />
          <TextBlock Name="PART_DetailsToggleText" Text="技术详情" VerticalAlignment="Center" />
          <TextBlock Name="PART_DetailsChevron" Classes="icon" Text="&#xE70D;" FontSize="10"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
        <Button Name="PART_Copy" Classes="textlink quiet" Content="复制" />
        <Button Name="PART_Export" Classes="textlink quiet" Content="导出…" />
        <Button Name="PART_Delete" Classes="textlink quiet danger" Content="删除" />
      </StackPanel>
    </Grid>

    <!-- 固定最小高度：提示与操作结果互换时不顶动底部按钮 -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0" MinHeight="36">
      <TextBlock Name="PART_HintIcon" Classes="icon" Text="&#xE72E;" FontSize="12"
                 Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,3,8,0" VerticalAlignment="Top" />
      <TextBlock Grid.Column="1" Name="PART_Hint" Classes="cardmeta" TextWrapping="Wrap" LineHeight="18"
                 VerticalAlignment="Top" />
      <Button Grid.Column="2" Name="PART_Reveal" Classes="textlink" Content="打开文件夹"
              IsVisible="False" Margin="12,0,0,0" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="*,12,*" Margin="0,16,0,0">
      <Button Name="PART_Close" Classes="outline" Height="42" Content="关闭" />
      <Button Grid.Column="2" Name="PART_Restart" Classes="primary" Height="42"
              Content="重新启动" IsDefault="True" />
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Border.errorcard">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="SelectableTextBlock.cardbody">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style Selector="TextBlock.cardmeta">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
    <Style Selector="Button.textlink">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.textlink:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>
    <Style Selector="Button.textlink.quiet">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="Button.textlink.quiet:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- armed = 等待第二次点击确认删除 -->
    <Style Selector="Button.textlink.danger:pointerover, Button.textlink.danger.armed">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    </Style>
    <Style Selector="Button.textlink.danger.armed">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.textlink:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Window.Styles>
</views:MolaContentWindow>
