<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MolaGPT.App.Views"
             x:Class="MolaGPT.App.Views.NotificationBanner"
             Width="344">

  <!--
    One transient event. The floating recipe is Border.flyoutsurface verbatim
    (Bg.Elevated + Border.Strong 1px + Radius.Md + the same box shadow), so a
    banner reads as the same class of object as a flyout rather than as a new
    kind of surface.

    Semantic colour lives on the icon and nowhere else: four kinds of tinted
    344px card turn the top-right corner into an advert, and a left colour bar
    is a second emphasis for something the icon already says.
  -->
  <Border Name="PART_Card"
          BorderThickness="1"
          ClipToBounds="True">
    <Panel>
      <Grid Name="PART_Layout" ColumnDefinitions="20,*,Auto">

        <TextBlock Grid.Column="0" Name="PART_Icon" Classes="icon"
                   FontSize="15" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,1,0,0" />

        <StackPanel Grid.Column="1" Name="PART_Text" Margin="10,0,0,0">
          <TextBlock Name="PART_Title"
                     FontSize="13" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.Text.Primary}" />

          <TextBlock Name="PART_Body"
                     FontSize="12" Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.Text.Secondary}" />

          <ProgressBar Name="PART_Progress"
                       Margin="0,9,0,0" Height="3" MinWidth="0"
                       Minimum="0" Maximum="1"
                       Foreground="{DynamicResource Brush.Primary}"
                       Background="{DynamicResource Brush.Bg.Tertiary}" />

          <Button Name="PART_Action" Classes="pillprimary"
                  Margin="0,9,0,0" Padding="13,5" MinHeight="0"
                  FontSize="12" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Kept invisible until the pointer is over the banner: three stacked
             cards each showing a close glyph outweigh the content itself. -->
        <StackPanel Grid.Column="2" Name="PART_Actions" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Name="PART_Close" Classes="inlineaction"
                Width="22" Height="22" Padding="0" FontSize="10"
                VerticalAlignment="Top" Opacity="0"
                ToolTip.Tip="关闭">
          <TextBlock Classes="icon" Text="&#xE8BB;" FontSize="10" />
        </Button>
        </StackPanel>
      </Grid>

      <!-- Auto-dismiss countdown. Without it a banner vanishing on its own
           looks like a glitch; with it, the disappearance was announced. -->
      <Border Name="PART_Timer" Height="2" Width="0"
              VerticalAlignment="Bottom" HorizontalAlignment="Left"
              Opacity="0.28" IsVisible="False" />
    </Panel>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border#PART_Card">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="BoxShadow" Value="0 10 30 0 #3D16202A" />
    </Style>
    <Style Selector="Grid#PART_Layout">
      <Setter Property="Margin" Value="14,12,12,12" />
    </Style>
    <Style Selector="TextBlock#PART_Title">
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock#PART_Body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow Border#PART_Card">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #2616202A" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow Grid#PART_Layout">
      <Setter Property="Margin" Value="12,10" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow TextBlock#PART_Title">
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow TextBlock#PART_Body">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow.details TextBlock#PART_Title">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow.details Border#PART_Card">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="views|NotificationBanner.secondarywindow.details TextBlock#PART_Body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="0" />
    </Style>
  </UserControl.Styles>
</UserControl>
