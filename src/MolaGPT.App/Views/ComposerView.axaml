<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MolaGPT.ViewModels;assembly=MolaGPT.ViewModels"
             xmlns:att="clr-namespace:MolaGPT.Core.Models;assembly=MolaGPT.Core"
             xmlns:r="clr-namespace:MolaGPT.App.Rendering"
             xmlns:views="clr-namespace:MolaGPT.App.Views"
             x:Class="MolaGPT.App.Views.ComposerView"
             x:DataType="vm:ComposerViewModel"
             Background="Transparent">

  <Border Name="PART_Shell" Classes="composer" DragDrop.AllowDrop="True">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

      <!-- Row 0: attachment strip. Collapses entirely when nothing is queued. -->
      <Border Grid.Row="0" Classes="attachstrip" IsVisible="{Binding HasAttachments}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
            <StackPanel Grid.Column="0" Classes="inlinerow compact" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="icon" Text="&#xE723;" FontSize="11" Margin="0,0,4,0"
                         Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" />
              <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"
                         VerticalAlignment="Center">
                <Run Text="已上传 " />
                <Run Text="{Binding Attachments.Count}"
                     Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" />
                <Run Text=" 个文件" />
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Padding="6,2" FontSize="12"
                    Command="{Binding ClearAttachmentsCommand}" ToolTip.Tip="清空所有文件">
              <StackPanel Classes="inlinerow compact" Orientation="Horizontal">
                <TextBlock Classes="icon" Text="&#xE74D;" FontSize="10" Margin="0,0,3,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="清空" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="att:Attachment">
                <Border Classes="attachchip" ToolTip.Tip="{Binding FileName}"
                        PointerReleased="OnAttachmentCardClick">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- 32×32 thumbnail: the queued bytes for an image, a typed
                         glyph otherwise. -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{DynamicResource Radius.Xs}"
                            Background="{DynamicResource Brush.Bg.Tertiary}"
                            Margin="0,0,6,0" ClipToBounds="True">
                      <Panel>
                        <r:AttachmentThumbnail Bytes="{Binding Bytes}"
                                               IsVisible="{Binding IsImage}" />
                        <TextBlock Classes="icon" Text="&#xE7C3;" FontSize="16"
                                   IsVisible="{Binding !IsImage}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2" Margin="4,0,0,0" Width="18" Height="18" Padding="0"
                            VerticalAlignment="Center" Opacity="0.55" ToolTip.Tip="移除"
                            Click="OnRemoveAttachment">
                      <TextBlock Classes="icon" Text="&#xE711;" FontSize="10"
                                 Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Row 1: toolbar. ToolPlainButton / ToolToggleButton, 30 high, radius 10. -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
        <Button Name="PART_Persona" Classes="toolchip"
                IsVisible="{Binding IsPersonaPickerVisible}"
                ToolTip.Tip="选择对话角色 / 系统提示词">
          <StackPanel Classes="inlinerow" Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{Binding Chat.ActivePersonaAvatar}"
                       FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Chat.ActivePersonaName}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="molaflyout">
              <Border Classes="flyoutsurface personapanel" MinWidth="340" MaxWidth="420">
                <Grid RowDefinitions="Auto,*,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,2,4,8">
                    <TextBlock Text="选择角色" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Name="PART_ClearPersona" Classes="toolchip"
                            Padding="8,2" Height="26" MinHeight="26"
                            IsVisible="False"
                            Content="清除角色" ToolTip.Tip="恢复默认助手" />
                  </Grid>

                  <ScrollViewer Grid.Row="1" MaxHeight="360"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <!-- 图像工作台 used to open from a row at the top of this
                         list. It moved to the sidebar, beside 新建对话: this
                         flyout is for personas, and hanging the workbench here
                         tied its visibility to IsPersonaPickerVisible — which is
                         false in MolaGPT proxy mode, so users on the hosted
                         provider could not reach the workbench at all even with
                         an image model configured. The workbench keeps its own
                         provider settings and never depended on the chat's. -->
                    <StackPanel>
                      <ItemsControl Name="PART_PersonaList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="views:PersonaSelectorRow">
                            <Button Classes="personarow" Tag="{Binding Id}" Click="OnPickPersona">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="icon" Text="{Binding Avatar}"
                                           FontSize="16" Width="28" TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Preview}" Classes="muted" FontSize="12"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Classes="icon" Text="&#xE73E;"
                                           IsVisible="{Binding IsActive}" FontSize="14"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>

                  <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Divider}"
                          BorderThickness="0,1,0,0" Padding="4,8,4,0" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Name="PART_NewPersona" Classes="toolchip" HorizontalAlignment="Left">
                        <StackPanel Classes="inlinerow compact" Orientation="Horizontal">
                          <TextBlock Classes="icon" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                          <TextBlock Text="新建角色" FontSize="12" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Name="PART_ManagePersonas" Classes="toolchip"
                              Content="管理角色" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Name="PART_Attach" Classes="toolchip"
                IsVisible="{Binding IsAttachVisible}"
                ToolTip.Tip="上传文件 / 图片">
          <StackPanel Classes="inlinerow" Orientation="Horizontal">
            <TextBlock Classes="icon" Text="&#xE723;" FontSize="12" Margin="0,0,6,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="附件" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <ToggleButton Name="PART_Thinking" Classes="toolchip"
                      IsChecked="{Binding EnableThinking, Mode=TwoWay}"
                      IsVisible="{Binding IsThinkingVisible}"
                      ToolTip.Tip="开启推理：复杂问题先推理后回答">
          <StackPanel Classes="inlinerow" Orientation="Horizontal">
            <TextBlock Classes="icon" Text="&#xE82F;" FontSize="12" Margin="0,0,6,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="推理" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <Button Name="PART_Effort" Classes="toolchip"
                IsVisible="{Binding IsReasoningEffortVisible}"
                ToolTip.Tip="{Binding ReasoningControlToolTip}">
          <StackPanel Classes="inlinerow" Orientation="Horizontal">
            <TextBlock Classes="icon" Text="&#xF8B0;" FontSize="12" Margin="0,0,6,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ReasoningControlLabel}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="molaflyout">
              <Border Classes="flyoutsurface effortpanel">
                <StackPanel MinWidth="230">
                  <TextBlock Text="{Binding ReasoningControlTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                  <ListBox ItemsSource="{Binding AvailableEffortLevels}"
                           SelectedItem="{Binding ReasoningEffort, Mode=TwoWay}"
                           IsVisible="{Binding IsEffortComboVisible}"
                           Classes="chiplist">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static views:EffortLabelConverter.Instance}}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel IsVisible="{Binding IsBudgetSliderVisible}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                      <TextBlock Text="Token Budget" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding ThinkingBudgetTokens}" FontSize="12" />
                    </Grid>
                    <Slider Minimum="{Binding BudgetMin}" Maximum="{Binding BudgetMax}"
                            Value="{Binding ThinkingBudgetTokens, Mode=TwoWay}"
                            TickFrequency="1024" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <ToggleButton Name="PART_Network" Classes="toolchip"
                      IsChecked="{Binding EnableNetwork, Mode=TwoWay}"
                      IsEnabled="{Binding AreNetworkToolsEnabled}"
                      ToolTip.Tip="联网搜索">
          <StackPanel Classes="inlinerow" Orientation="Horizontal">
            <TextBlock Classes="icon" Text="&#xE721;" FontSize="12" Margin="0,0,6,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="联网搜索" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <ToggleButton Name="PART_WebFetch" Classes="toolchip"
                      IsChecked="{Binding EnableWebFetch, Mode=TwoWay}"
                      IsEnabled="{Binding AreNetworkToolsEnabled}"
                      ToolTip.Tip="网页阅读">
          <StackPanel Classes="inlinerow" Orientation="Horizontal">
            <TextBlock Classes="icon" Text="&#xE774;" FontSize="12" Margin="0,0,6,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="网页阅读" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>

      <Border Grid.Row="2" Classes="imageoptions" IsVisible="{Binding IsImageOptionsVisible}">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
            <TextBlock Text="比例" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ListBox Name="PART_AspectRatio" Classes="chiplist"
                     ItemsSource="{Binding ImageAspectRatioOptions}"
                     SelectedValue="{Binding ImageAspectRatio, Mode=TwoWay}"
                     SelectedValueBinding="{Binding Value}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ImageGenerationOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="风格" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ListBox Name="PART_ImageStyle" Classes="chiplist"
                     ItemsSource="{Binding ImageStyleOptions}"
                     SelectedValue="{Binding ImageStyle, Mode=TwoWay}"
                     SelectedValueBinding="{Binding Value}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ImageGenerationOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </WrapPanel>
      </Border>

      <!-- Row 3: textarea. ComposerTextBox — MinHeight 56, MaxHeight 240,
           Padding 6,4, Font.Cjk at Font.Size.BodyLg. -->
      <TextBox Grid.Row="3"
               Name="PART_Input"
               Text="{Binding Text, Mode=TwoWay}"
               PlaceholderText="{Binding ComposerPlaceholder}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="56"
               MaxHeight="240"
               Padding="6,4"
               FontFamily="{DynamicResource Font.Cjk}"
               FontSize="{DynamicResource Font.Size.BodyLg}"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

      <!-- Row 4: hint on the left, send/stop on the right -->
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
        <Panel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Name="PART_Hint" Classes="muted"
                     FontSize="{DynamicResource Font.Size.XSmall}"
                     Text="Enter 发送 · Shift+Enter 换行"
                     IsVisible="{Binding EnterToSend}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.XSmall}"
                     Text="Enter 换行 · Ctrl+Enter 发送"
                     IsVisible="{Binding !EnterToSend}" />
        </Panel>

        <!-- Send and stop swap places rather than one button changing meaning:
             a button whose action changes under the cursor mid-stream is how
             people cancel answers they wanted to keep. -->
        <Panel Grid.Column="1">
          <Button Name="PART_Send"
                  Classes="send"
                  Command="{Binding SendCommand}"
                  IsVisible="{Binding !IsSending}"
                   ToolTip.Tip="发送 (Ctrl+Enter)">
            <TextBlock Classes="icon" Text="&#xE724;" FontSize="14"
                       Foreground="{DynamicResource Brush.Text.OnPrimary}" />
          </Button>
          <Button Name="PART_Stop"
                  Classes="send stop"
                  Command="{Binding StopCommand}"
                  IsVisible="{Binding IsSending}"
                  ToolTip.Tip="停止">
            <TextBlock Classes="icon" Text="&#xE71A;" FontSize="14"
                       Foreground="{DynamicResource Brush.Text.OnPrimary}" />
          </Button>
        </Panel>
      </Grid>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Xl}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <!-- "brand-tinted border while typing, so the active input surface reads at
         a glance" — the original's IsKeyboardFocusWithin trigger. -->
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Border}" />
    </Style>

    <Style Selector="Border.attachstrip">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.attachchip">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <!-- Chips arrive one at a time as files finish reading, so each one is its
         own event and gets its own entry. The WrapPanel is not virtualized, so
         this runs once per chip and never replays. -->
    <Style Selector="Border.attachchip">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.9" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The strip and the image-options row both push the whole composer up
         when they appear. Sliding them out from under the text box makes the
         composer look like it grew rather than like the page jumped. -->
    <Style Selector="Border.attachstrip[IsVisible=True],
                     Border.imageoptions[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.personapanel, Border.effortpanel">
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Button.personarow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.personarow:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.HoverOverlay}" />
    </Style>

    <Style Selector="Border.imageoptions">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ListBox.chiplist">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.chiplist ListBoxItem">
      <Setter Property="Margin" Value="0,0,5,4" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.chiplist ListBoxItem:selected /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="ListBox.chiplist ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ToolToggleButton / ToolPlainButton: 30 high, radius 10, Font.Cjk 12
         Medium, brand tint when checked. -->
    <Style Selector=":is(Button).toolchip">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Cjk}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector=":is(Button).toolchip:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.HoverOverlay}" />
    </Style>
    <Style Selector=":is(Button).toolchip:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ToggleButton.toolchip:checked /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Tint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Border}" />
    </Style>
    <Style Selector="ToggleButton.toolchip:checked">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>

    <!-- Button.send / .stop, the swap animation and the disabled state moved to
         Theme/Controls.axaml: the image workbench's composer runs the same
         send↔stop hand-off and was drifting from this one. -->
  </UserControl.Styles>
</UserControl>
