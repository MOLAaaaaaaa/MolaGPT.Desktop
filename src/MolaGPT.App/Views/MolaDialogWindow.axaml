<views:MolaWindow xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:views="clr-namespace:MolaGPT.App.Views"
                  x:Class="MolaGPT.App.Views.MolaDialogWindow"
                  Width="420"
                  MinWidth="360"
                  MaxWidth="420"
                  SizeToContent="Height"
                  CanResize="False"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner">
  <DockPanel>
    <views:MolaWindowTitleBar DockPanel.Dock="Top" Name="PART_TitleBar" />
    <ContentControl Name="PART_Body" />
  </DockPanel>
</views:MolaWindow>
