<views:MolaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MolaGPT.App.Views"
        xmlns:vm="clr-namespace:MolaGPT.ViewModels;assembly=MolaGPT.ViewModels"
        xmlns:r="clr-namespace:MolaGPT.App.Rendering"
        x:Class="MolaGPT.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MolaGPT"
        Width="1240" Height="820"
        MinWidth="880" MinHeight="560"
        Background="{DynamicResource Brush.Bg.Canvas}"
        FontFamily="{DynamicResource Font.UI}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        WindowStartupLocation="CenterScreen">

  <!--
    Shell, matching MolaGPT.Desktop/Views/MainWindow.xaml:

      canvas (Brush.Bg.Canvas)
        └ 46px self-drawn title bar
        └ Grid Margin="16,6,16,16"
            ├ sidebar card   280px   (Brush.Bg.Secondary, Radius.Xl)
            ├ gap            16px
            └ main card      *       (Brush.Bg.Xxl)

    The cards float on the canvas rather than meeting edge to edge, and the
    composer floats inside the main card over the transcript — it is not a
    layout row. Both are load-bearing for the look, so they are reproduced
    exactly rather than approximated.

    MolaWindow supplies the native DWM shell while this view draws the title bar.
  -->

  <LayoutTransformControl Name="PART_UiScale">
    <Panel>
    <DockPanel Name="PART_Root">

    <!-- ============================ title bar ============================ -->
    <views:TitleBar DockPanel.Dock="Top" Name="PART_TitleBar" />

    <!-- ============================== body =============================== -->
    <Grid Name="PART_BodyGrid" Margin="16,6,16,16" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

      <Border Grid.Column="0"
              Name="PART_SidebarCard"
              Classes="floatingcard"
              Width="{DynamicResource Size.Sidebar.Width}"
              Background="{DynamicResource Brush.Bg.Secondary}"
              ClipToBounds="True">
        <views:SidebarView Name="PART_Sidebar" />
      </Border>

      <!-- Gap column collapses with the sidebar so the main card reclaims it. -->
      <Border Grid.Column="1" Name="PART_SidebarGap" Width="16" />

      <Border Grid.Column="2"
              Name="PART_MainCard"
              Background="{DynamicResource Brush.Bg.Primary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Xxl}"
              ClipToBounds="True">
        <Grid>
          <Grid IsVisible="{Binding !IsImageWorkbenchVisible}">
            <!-- Transcript fills the card; the composer floats over it. -->
            <views:TranscriptView Name="PART_Transcript" />
            <views:ComposerView Name="PART_Composer"
                                VerticalAlignment="Bottom"
                                Margin="40,0,40,24" />
          </Grid>
          <ContentControl Name="PART_ImageWorkbenchHost"
                          Margin="0,72,0,0"
                          IsVisible="{Binding IsImageWorkbenchVisible}" />
          <views:ChatHeader Name="PART_Header" VerticalAlignment="Top" />
        </Grid>
      </Border>

      <!-- A slim tab riding the chat card's right edge, exactly where the WPF
           build put it. It shares the chat column rather than owning one: as its
           own column it shifted the whole layout, and it kept a 36px gutter even
           with the panel closed. -->
      <Button Grid.Column="2" Name="PART_ArtifactHandle"
              ZIndex="50"
              Width="22" Height="64" Margin="0,0,14,0"
              HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
              Classes="artifacthandle"
              IsVisible="{Binding IsArtifactHandleVisible}"
              Command="{Binding ToggleArtifactPanelCommand}"
               ToolTip.Tip="侧边栏" AutomationProperties.Name="侧边栏">
        <Panel>
          <!-- Closed → points left, "pull it out". Open → points right, "push
               it back". These were the wrong way round, so the arrow described
               the state it was in rather than the action it would perform. -->
          <TextBlock Classes="icon" Text="&#xE76B;" FontSize="12"
                     IsVisible="{Binding !ArtifactPanelVisible}" />
          <TextBlock Classes="icon" Text="&#xE76C;" FontSize="12"
                     IsVisible="{Binding ArtifactPanelVisible}" />
        </Panel>
      </Button>

      <Border Grid.Column="3" Name="PART_ArtifactGap" Width="0"
              Background="Transparent" Cursor="SizeWestEast"
              PointerPressed="OnArtifactResizePressed"
              PointerMoved="OnArtifactResizeMoved"
              PointerReleased="OnArtifactResizeReleased">
        <Border Width="2" Height="44" CornerRadius="{DynamicResource Radius.Pill}"
                Background="{DynamicResource Brush.Border.Strong}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding ArtifactCanvasVisible}" />
      </Border>

      <Border Grid.Column="4" Name="PART_ArtifactCard"
              Width="0"
              Background="{DynamicResource Brush.Bg.Primary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}"
              BorderThickness="1" CornerRadius="{DynamicResource Radius.Xxl}"
              ClipToBounds="True">
        <Grid Margin="16,14,14,14" RowDefinitions="Auto,Auto,*">
          <!-- Header: what this is, how many, and the list / canvas switch. -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="2,0,0,12">
            <StackPanel VerticalAlignment="Center" Spacing="2" IsVisible="{Binding IsArtifactPanelSelected}">
              <TextBlock Text="交付物" FontWeight="SemiBold"
                         FontSize="{DynamicResource Font.Size.Heading}"
                         TextWrapping="NoWrap" />
              <TextBlock Text="{Binding Chat.ArtifactCount, StringFormat='{}{0} 项'}"
                         Classes="muted"
                         FontSize="{DynamicResource Font.Size.XSmall}"
                         TextWrapping="NoWrap"
                         IsVisible="{Binding Chat.HasArtifacts}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Spacing="2" IsVisible="{Binding SubagentPanelSelected}">
              <TextBlock Text="子 Agent" FontWeight="SemiBold"
                         FontSize="{DynamicResource Font.Size.Heading}" />
              <TextBlock Text="{Binding Chat.SubagentCount, StringFormat='{}{0} 个'}"
                         Classes="muted" FontSize="{DynamicResource Font.Size.XSmall}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="artifacttabs" VerticalAlignment="Center" Margin="8,0,6,0"
                     IsVisible="{Binding IsArtifactPanelSelected}">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="artifacttab" Content="列表"
                              Command="{Binding ShowArtifactListCommand}"
                              IsChecked="{Binding !ArtifactCanvasVisible, Mode=OneWay}" />
                <ToggleButton Classes="artifacttab" Content="画布"
                              Command="{Binding ShowArtifactCanvasCommand}"
                              IsChecked="{Binding ArtifactCanvasVisible, Mode=OneWay}" />
              </StackPanel>
            </Border>
            <Button Grid.Column="2" Classes="headericon" VerticalAlignment="Center"
                    Command="{Binding ToggleArtifactPanelCommand}"
                    ToolTip.Tip="收起">
              <TextBlock Classes="icon" Text="&#xE8BB;" />
            </Button>
          </Grid>

          <Border Grid.Row="1" Classes="artifacttabs" HorizontalAlignment="Left"
                  Margin="0,0,0,12" IsVisible="{Binding Chat.HasSubagents}">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Classes="artifacttab" Content="交付物"
                            Command="{Binding ShowArtifactListCommand}"
                            IsVisible="{Binding Chat.HasArtifacts}"
                            IsChecked="{Binding IsArtifactPanelSelected, Mode=OneWay}" />
              <ToggleButton Classes="artifacttab" Content="子 Agent"
                            Command="{Binding ShowSubagentListCommand}"
                            IsChecked="{Binding SubagentPanelSelected, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" IsVisible="{Binding IsArtifactPanelSelected}">
          <!-- list -->
          <Grid IsVisible="{Binding !ArtifactCanvasVisible}">
            <TextBlock Text="暂无交付物" Classes="muted"
                       Margin="2,8,2,0" IsVisible="{Binding !Chat.HasArtifacts}" />
            <ScrollViewer IsVisible="{Binding Chat.HasArtifacts}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Chat.Artifacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ArtifactItemViewModel">
                    <Button Classes="artifactrow" Tag="{Binding}" Click="OnArtifactClick"
                            ToolTip.Tip="{Binding ToolTip}">
                      <Button.ContextMenu>
                        <ContextMenu Opened="OnArtifactMenuOpened">
                          <MenuItem Header="打开" Click="OnArtifactMenuOpen" />
                          <MenuItem Header="打开文件夹" Click="OnArtifactMenuOpenFolder" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="40,*">
                        <Border Grid.Column="0" Width="36" Height="36"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                          <Panel>
                            <r:MarkdownImageView Url="{Binding ImagePreviewPath}" Alt="{Binding FileName}"
                                                 IsVisible="{Binding IsImage}" />
                            <Border Classes="artifactbadge" IsVisible="{Binding !IsImage}">
                              <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Text.Secondary}"
                                         TextWrapping="NoWrap"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                          <!-- NoWrap is load-bearing: the app-wide TextBlock style
                               sets TextWrapping=Wrap, so TextTrimming never got a
                               chance and long names broke across two lines. -->
                          <TextBlock Text="{Binding FileName}" FontSize="12"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ListSubtitle}" Classes="muted" FontSize="11"
                                     TextWrapping="NoWrap" Margin="0,2,0,0" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- canvas -->
          <Grid IsVisible="{Binding ArtifactCanvasVisible}" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="headericon" Command="{Binding SelectPreviousArtifactCommand}" ToolTip.Tip="上一项">
                  <TextBlock Classes="icon" Text="&#xE76B;" />
                </Button>
                <Button Classes="headericon" Command="{Binding SelectNextArtifactCommand}" ToolTip.Tip="下一项">
                  <TextBlock Classes="icon" Text="&#xE76C;" />
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedArtifact.FileName}" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding SelectedArtifact.Extension}" Classes="artifactkind" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SelectedArtifact.SizeLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <!-- Versions: every revision that kept the same file name. -->
                  <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                              IsVisible="{Binding SelectedArtifact.HasVersions}">
                    <Button Classes="versionstep" Command="{Binding SelectPreviousVersionCommand}"
                            IsEnabled="{Binding SelectedArtifact.CanSelectPreviousVersion}" ToolTip.Tip="上一版">
                      <TextBlock Classes="icon" Text="&#xE76B;" FontSize="9" />
                    </Button>
                    <TextBlock Text="{Binding SelectedArtifact.VersionLabel}" FontSize="11"
                               VerticalAlignment="Center" Margin="2,0" />
                    <Button Classes="versionstep" Command="{Binding SelectNextVersionCommand}"
                            IsEnabled="{Binding SelectedArtifact.CanSelectNextVersion}" ToolTip.Tip="下一版">
                      <TextBlock Classes="icon" Text="&#xE76C;" FontSize="9" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="headericon" Command="{Binding ReviseArtifactCommand}"
                        CommandParameter="{Binding SelectedArtifact}"
                        IsVisible="{Binding CanReviseSelectedArtifact}" ToolTip.Tip="基于此修改">
                  <TextBlock Classes="icon" Text="&#xE70F;" />
                </Button>
                <Button Classes="headericon" Command="{Binding ToggleArtifactSourceModeCommand}" AutomationProperties.Name="源码 / 预览"
                        IsVisible="{Binding CanShowSelectedArtifactSource}" ToolTip.Tip="源码 / 预览">
                  <Panel>
                    <TextBlock Classes="icon" Text="&#xE943;" IsVisible="{Binding !ArtifactSourceMode}" />
                    <TextBlock Classes="icon" Text="&#xE7B3;" IsVisible="{Binding ArtifactSourceMode}" />
                  </Panel>
                </Button>
                <Button Classes="headericon" Command="{Binding CopyArtifactCommand}"
                        CommandParameter="{Binding SelectedArtifact}"
                        IsVisible="{Binding CanCopySelectedArtifact}" ToolTip.Tip="复制源码">
                  <TextBlock Classes="icon" Text="&#xE8C8;" />
                </Button>
                <Button Classes="headericon" Command="{Binding RevealArtifactCommand}"
                        CommandParameter="{Binding SelectedArtifact}"
                        IsVisible="{Binding CanRevealSelectedArtifact}" ToolTip.Tip="在资源管理器中显示">
                  <TextBlock Classes="icon" Text="&#xE838;" />
                </Button>
                <Button Classes="headericon" Command="{Binding ToggleArtifactCanvasMaximizedCommand}"
                        ToolTip.Tip="放大或还原">
                  <Panel>
                    <TextBlock Classes="icon" Text="&#xE740;" IsVisible="{Binding !ArtifactCanvasMaximized}" />
                    <TextBlock Classes="icon" Text="&#xE73F;" IsVisible="{Binding ArtifactCanvasMaximized}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Classes="artifactcanvasbody">
              <views:ArtifactCanvasBodyHost Name="PART_ArtifactCanvas" Main="{Binding}" />
            </Border>
          </Grid>
          </Grid>

          <Grid Grid.Row="2" IsVisible="{Binding SubagentPanelSelected}">
            <ScrollViewer IsVisible="{Binding IsSubagentListVisible}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Chat.Subagents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SubagentViewModel">
                    <Button Classes="artifactrow" Tag="{Binding}" Click="OnSubagentClick">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Classes="taskstatus" Margin="8,0,0,0"
                                  Classes.done="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <r:RingSpinner Width="12" Height="12" VerticalAlignment="Center"
                                             IsVisible="{Binding IsRunning}" />
                              <TextBlock Classes="icon" Text="&#xE73E;" FontSize="12" IsVisible="{Binding IsCompleted}" />
                              <TextBlock Classes="icon" Text="&#xEA39;" FontSize="12" IsVisible="{Binding IsFailed}" />
                              <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Model}" Classes="muted" FontSize="11"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentAction}" Classes="muted" FontSize="11"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding IsRunning}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Grid IsVisible="{Binding IsSubagentDetailVisible}" RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <Button Grid.Column="0" Classes="headericon" Command="{Binding ShowSubagentListCommand}"
                        ToolTip.Tip="返回列表">
                  <TextBlock Classes="icon" Text="&#xE76B;" />
                </Button>
                <StackPanel Grid.Column="1" Margin="8,0" Spacing="2">
                  <TextBlock Text="{Binding SelectedSubagent.Label}" FontSize="13" FontWeight="SemiBold"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="taskstatus" Classes.done="{Binding SelectedSubagent.IsCompleted}"
                            Classes.failed="{Binding SelectedSubagent.IsFailed}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <r:RingSpinner Width="12" Height="12" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedSubagent.IsRunning}" />
                        <TextBlock Classes="icon" Text="&#xE73E;" FontSize="12"
                                   IsVisible="{Binding SelectedSubagent.IsCompleted}" />
                        <TextBlock Classes="icon" Text="&#xEA39;" FontSize="12"
                                   IsVisible="{Binding SelectedSubagent.IsFailed}" />
                        <TextBlock Text="{Binding SelectedSubagent.StatusText}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedSubagent.ElapsedText}" Classes="muted" FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="toolchip" Content="停止"
                        Command="{Binding SelectedSubagent.StopCommand}"
                        IsVisible="{Binding SelectedSubagent.IsRunning}" />
              </Grid>
              <ScrollViewer Grid.Row="1" Name="PART_SubagentScroll"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedSubagent.Activity}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubagentActivityViewModel">
                      <StackPanel Margin="0,0,0,12">
                        <Border Classes="artifactbadge" CornerRadius="{DynamicResource Radius.Sm}" Padding="9"
                                IsVisible="{Binding IsTask}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="任务" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TaskText}" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <StackPanel IsVisible="{Binding IsThinking}" Spacing="4">
                          <TextBlock Text="思考" Classes="muted" FontSize="11" />
                          <SelectableTextBlock Text="{Binding Message.Content}" FontSize="12"
                                               TextWrapping="Wrap" IsVisible="{Binding Message.IsStreaming}" />
                          <r:MarkdownTextBlock Markdown="{Binding RenderedMarkdown}" FontSize="12"
                                               TextWrapping="Wrap" IsVisible="{Binding !Message.IsStreaming}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsText}">
                          <SelectableTextBlock Text="{Binding Message.Content}" FontSize="13"
                                               TextWrapping="Wrap" IsVisible="{Binding Message.IsStreaming}" />
                          <r:MarkdownTextBlock Markdown="{Binding RenderedMarkdown}" FontSize="13"
                                               TextWrapping="Wrap" IsVisible="{Binding !Message.IsStreaming}" />
                        </StackPanel>
                        <Expander IsVisible="{Binding IsTool}">
                          <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto" MinWidth="240">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Tool.DisplayLabel}" FontSize="12"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Tool.HeaderArgPreview}" Classes="muted" FontSize="11"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Tool.HasHeaderArgPreview}" />
                              </StackPanel>
                              <Border Grid.Column="1" Classes="taskstatus" Margin="8,0,0,0"
                                      Classes.done="{Binding Tool.IsCompleted}" Classes.failed="{Binding Tool.IsError}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <r:RingSpinner Width="12" Height="12" VerticalAlignment="Center"
                                                 IsVisible="{Binding ShowsSpinner}" />
                                  <TextBlock Classes="icon" Text="&#xE73E;" FontSize="12"
                                             IsVisible="{Binding Tool.IsCompleted}" />
                                  <TextBlock Classes="icon" Text="&#xEA39;" FontSize="12"
                                             IsVisible="{Binding Tool.IsError}" />
                                  <TextBlock Text="{Binding Tool.StatusText}" />
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Expander.Header>
                          <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Tool.Detail}" Classes="muted" FontSize="11"
                                       TextWrapping="Wrap" IsVisible="{Binding Tool.HasDetail}" />
                            <r:RawPayloadView Text="{Binding Tool.DisplayArgumentsJson}"
                                              IsVisible="{Binding Tool.HasArguments}" />
                            <r:RawPayloadView Text="{Binding Tool.DisplayResultPreviewJson}"
                                              IsVisible="{Binding Tool.HasResultPreview}" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SelectedSubagent.FailureText}"
                           Classes="muted" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedSubagent.HasFailure}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </DockPanel>

    <!-- Notification banners float over the whole shell, anchored just under
         the title bar at the window's right edge. They sit outside the body
         grid so they do not move with the sidebar or the artifact panel. -->
    <views:NotificationHost Name="PART_Notifications" ZIndex="80"
                            Margin="0,58,30,0" />
    </Panel>
  </LayoutTransformControl>

  <Window.Styles>
    <Style Selector="Button.artifacthandle">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- BoxShadow lives on Border, not Button, so it has to reach the template. -->
    <Style Selector="Button.artifacthandle /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="0 0 8 0 #40000000" />
    </Style>
    <Style Selector="Button.artifacthandle:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
    </Style>

    <Style Selector="Button.artifactrow">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button.artifactrow:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Tint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Border}" />
    </Style>
    <Style Selector="Border.artifactbadge">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
    </Style>
    <Style Selector="Border.artifacttabs">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ToggleButton.artifacttab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Xs}" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ToggleButton.artifacttab:checked /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Primary}" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #16000000" />
    </Style>
    <Style Selector="Border.artifactcanvasbody">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.artifactkind">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <!-- Under the canvas, outside the web view (nothing can sit on top of
         it): what the page loaded, and a page error with its one action. -->
    <Style Selector="Border.canvasfooter">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.canvaserror">
      <Setter Property="Padding" Value="10,4,6,4" />
      <Setter Property="Background" Value="{DynamicResource Brush.Danger.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Button.versionstep">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Xs}" />
    </Style>
    <Style Selector="Button.versionstep:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.HoverOverlay}" />
    </Style>
    <Style Selector="Border.artifacttableheader">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Tertiary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.artifacttablecell">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.artifactquote">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Border}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="{DynamicResource Brush.Primary.Blockquote}" />
    </Style>
    <Style Selector="Border.artifactdivider">
      <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    </Style>
  </Window.Styles>
</views:MolaWindow>
