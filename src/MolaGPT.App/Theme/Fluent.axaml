<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Light" Accent="#FFBE727F" />
      <ColorPaletteResources x:Key="Dark" Accent="#FFBE727F" />
    </FluentTheme.Palettes>
  </FluentTheme>
</Styles>
